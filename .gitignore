node_modules/
dist/
build/
.next/
out/
.turbo/
coverage/
apps/customer/deployment/host-dispatch.json
*.tsbuildinfo

# Compiled Solidity for svc-protocol — TRACKED ON PURPOSE, and the blanket
# `out/` above (Next.js static export) would otherwise swallow it silently.
#
# This is not build noise. It is the exact bytecode a deployment pushes, it is
# reviewable in a diff, and it lets tests and `chain:deploy` run without every
# machine invoking a compiler. It cannot rot unnoticed: each artefact carries a
# `sourceHash` over the compilation input that `chain/artifacts.test.ts`
# re-derives from the `.sol` files on disk.
!services/svc-protocol/contracts/out/
!services/svc-protocol/contracts/out/**

# Foundry scratch for S-A8 fuzz (not the solc-js artefacts under contracts/out/).
services/svc-protocol/forge-out/
services/svc-protocol/cache/

# Same reasoning, second caller. #218 added svc-indexer's own pinned suite
# (contracts/dev/DevVenue.sol) but not the matching negation, so `out/` above
# swallowed DevVenue.json exactly as it would have swallowed svc-protocol's.
#
# The failure only shows on a FRESH CLONE. The artefact sits happily in the
# worktree that compiled it, so local runs — and the authoring agent — both saw
# green, while svc-indexer's three live-chain tests fail for everyone else with
# MissingArtifactError. The shape of the bug: correct on
# the machine that made it, broken everywhere it lands.
!services/svc-indexer/contracts/out/
!services/svc-indexer/contracts/out/**

.env
.env.local
.env.*.local
!.env.example

*.log
npm-debug.log*
pnpm-debug.log*

.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# infra volumes
.docker-data/

# Proprietary Charting Library — purged (#106); use lightweight-charts (Apache-2.0).
# Do not re-add without a named TradingView licence on file.
vendor/**/charting_library/
**/charting_library/

# Stream A UI proof artefacts (screenshots, PROOF.md, devserver log/pid)
.artifacts/

# Local toolchains (Stream A Node 18, agent helpers)
.tools/

# Optional QuantLib native addon (platform .node — never commit a local build)
packages/greeks-adapter/native/build/
packages/greeks-adapter/native/*.node

# Local agent worktrees + pnpm store (never commit)
.worktrees/
.pnpm-store/

# Infra journal — one record per external-dependency probe, written by
# packages/db/src/infra-journal.ts and read by tooling/ci/infra-verdict.mjs so
# `pnpm verify` can name the suites that did not run. Per-run and per-worktree
# on purpose: two agents verifying at once must not read each other's skips.
.intafaced-run/

# Python bytecode from local SDK runs
__pycache__/
*.py[cod]

# Retired Graphify output and installer remnants from older local checkouts.
/graphify-out/
/.graphify/
/.agents/skills/graphify/
/.cursor/rules/graphify.mdc
