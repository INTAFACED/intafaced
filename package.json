{
  "name": "intafaced",
  "private": true,
  "version": "0.0.0",
  "description": "INTAFACED Sovereign OS \u2014 monorepo root. Law: INTAFACED_DEFINITIVE_BUILD.md",
  "packageManager": "pnpm@10.25.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "type": "module",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "build": "turbo run build",
    "mobile": "pnpm --filter mobile native:stage",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:watch": "turbo run test:watch",
    "clean": "turbo run clean && rimraf node_modules",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "infra:reset": "docker compose down -v && docker compose up -d",
    "platform:up": "docker compose -f docker-compose.apps.yml up -d --build",
    "fleet:tip-images": "node tooling/scripts/fleet-tip-image.mjs",
    "platform:up:founder": "docker compose --env-file .env --env-file .env.founder.local -f docker-compose.apps.yml up -d --build",
    "platform:down": "docker compose -f docker-compose.apps.yml down",
    "platform:logs": "docker compose -f docker-compose.apps.yml logs -f",
    "platform:ps": "docker compose -f docker-compose.apps.yml ps",
    "platform:reset": "docker compose -f docker-compose.apps.yml down -v && docker compose -f docker-compose.apps.yml up -d --build",
    "preview:outreach": "node tooling/preview/outreach/run.mjs",
    "wt": "node tooling/scripts/worktree.mjs create",
    "wt:base": "node tooling/scripts/worktree.mjs base",
    "wt:list": "node tooling/scripts/worktree.mjs list",
    "tracker": "node tooling/scripts/tracker.mjs",
    "tracker:check": "node tooling/scripts/tracker.mjs --check",
    "services:map": "node tooling/scripts/services-map.mjs",
    "gates": "node tooling/ci/gates.mjs",
    "test:gate-tools": "node tooling/scripts/gate-tools.test.mjs",
    "test:services-map": "node --test tooling/scripts/services-map.test.mjs",
    "value-gate:self-test": "node tooling/ci/value-gate.mjs --self-test",
    "pr": "node tooling/scripts/agent-pr.mjs",
    "verify": "node tooling/ci/verify.mjs",
    "verify:verdict": "node tooling/ci/infra-verdict.mjs",
    "gate": "node tooling/ci/dod-gate.mjs",
    "scan:coverage": "node tooling/ci/coverage-check.mjs",
    "coverage:report": "node tooling/ci/coverage-check.mjs --report",
    "scan:brand": "node tooling/ci/brand-scan.mjs",
    "scan:custody": "node tooling/ci/custody-scan.mjs",
    "scan:s2s": "node tooling/ci/s2s-scan.mjs",
    "scan:secrets": "node tooling/ci/secret-scan.mjs",
    "scan:gitleaks": "gitleaks detect --source . --no-git --config .gitleaks.toml",
    "scan:deps": "node tooling/ci/dependency-audit.mjs",
    "scan:secrets:mutate": "node tooling/ci/secret-scan.mutation.mjs --verbose",
    "scan:money-property:mutate": "node tooling/ci/money-property.mutation.mjs",
    "scan:compose-secrets": "node tooling/ci/compose-secret-parity.mjs",
    "scan:secret-rotation-readiness": "node tooling/ci/secret-rotation-readiness-scan.mjs",
    "scan:test-db": "node tooling/ci/test-db-scan.mjs",
    "scan:skip-honesty": "node tooling/ci/skip-honesty-scan.mjs",
    "scan:money-skip-honesty": "node tooling/ci/money-skip-honesty-scan.mjs",
    "order-path-smoke": "node tooling/scripts/order-path-smoke.mjs",
    "local:stack": "node tooling/scripts/local-test-stack.mjs start",
    "local:stack:stop": "node tooling/scripts/local-test-stack.mjs stop",
    "local:stack:restart": "node tooling/scripts/local-test-stack.mjs restart",
    "local:stack:plan": "node tooling/scripts/local-test-stack.mjs plan",
    "local:fund": "node tooling/scripts/local-test-stack.mjs fund",
    "local:stack:test": "node tooling/scripts/local-test-stack.test.mjs",
    "local:market": "node tooling/scripts/local-test-market.mjs",
    "local:market:stop": "node tooling/scripts/local-test-market.mjs stop",
    "local:market:test": "node tooling/scripts/local-test-market.test.mjs",
    "local:world": "node tooling/scripts/local-test-world.mjs watch",
    "local:world:seed": "node tooling/scripts/local-test-world.mjs seed",
    "local:world:test": "node tooling/scripts/local-test-world.test.mjs",
    "local:founder": "node tooling/scripts/local-founder-seed.mjs",
    "local:founder:test": "node --test tooling/scripts/local-founder-seed.test.mjs",
    "local:seed": "node tooling/scripts/local-test-seed.mjs",
    "local:seed:test": "node --test tooling/scripts/local-test-seed.test.mjs",
    "perf:book": "node tooling/perf/book-bench.mjs",
    "db:generate": "turbo run db:generate",
    "db:migrate": "turbo run db:migrate",
    "db:check": "node tooling/ci/migration-check.mjs",
    "format": "prettier --write \"**/*.{ts,tsx,mjs,js,md,json,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,mjs,js,md,json,yml,yaml}\"",
    "scan:workspace": "node tooling/ci/workspace-sync.mjs",
    "scan:events": "node tooling/ci/event-wiring.mjs",
    "frontend:preflight": "node tooling/frontend/preflight.mjs",
    "frontend:residual": "node tooling/frontend/residual-print.mjs",
    "frontend:preflight:craft": "SLICE_TYPE=CRAFT ORCA_REQUIRED=1 node tooling/frontend/preflight.mjs",
    "order-path-cx8": "node tooling/scripts/order-path-cx8-boot.mjs",
    "journeys:trade": "CX8_AFTER='[\"pnpm\",\"--filter\",\"@intafaced/customer\",\"run\",\"test:journeys\"]' node tooling/scripts/order-path-cx8-boot.mjs",
    "wt:gc": "node tooling/scripts/worktree-gc.mjs",
    "wt:gc:check": "node tooling/scripts/worktree-gc.mjs --check",
    "wt:gc:self-test": "node tooling/scripts/worktree-gc.mjs --self-test",
    "wt:self-test": "node tooling/scripts/worktree.mjs --self-test"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.20.5",
    "eslint": "^9.17.0",
    "prettier": "^3.9.10",
    "rimraf": "^6.0.1",
    "tsx": "^4.23.15",
    "turbo": "^2.11.10",
    "typescript": "^7.0.2",
    "vitest": "^4.1.12"
  },
  "pnpm": {
    "overrides": {
      "fast-uri@>=3.0.0 <3.1.9": "3.1.9",
      "fast-uri@>=4.0.0 <4.2.3": "4.2.3",
      "follow-redirects@<1.16.1": "1.16.1",
      "ip-address@>=10.0.0 <10.7.4": "10.7.4",
      "js-yaml@>=4.0.0 <4.3.1": "4.3.1",
      "nanoid@<3.3.18": "3.3.18",
      "nanoid@>=4.0.0 <5.1.6": "5.1.6",
      "tinypool@1.1.1": "2.1.2",
      "undici@>=7.0.0 <7.30.1": "7.30.1",
      "uuid@<11.1.1": "11.1.1"
    }
  }
}
