{
  "name": "@intafaced/customer",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 3200",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:deployment": "node --test deployment/host-dispatch.node-test.mjs deployment/validate-env.node-test.mjs deployment/security-headers.node-test.mjs",
    "test:journeys": "vitest run --config vitest.journeys.config.ts",
    "test:real-app": "playwright test --config tests/real-app/real-app.playwright.config.mjs",
    "test:watch": "vitest",
    "room:new": "node scripts/new-room.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 3200",
    "clean": "rimraf dist .turbo"
  },
  "dependencies": {
    "@intafaced/contracts": "workspace:*",
    "@intafaced/exchange-contract": "workspace:*",
    "@intafaced/i18n": "workspace:*",
    "@intafaced/money-math": "workspace:*",
    "@intafaced/ui": "workspace:*",
    "@tanstack/react-virtual": "3.14.22",
    "lucide-react": "1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "happy-dom": "21.0.4",
    "tailwindcss": "4.3.3",
    "typescript": "^7.0.2",
    "viem": "^2.57.10",
    "vite": "8.3.5",
    "vitest": "^3.0.5"
  }
}
