{
  "name": "mobile",
  "version": "0.0.0",
  "private": true,
  "type": "commonjs",
  "description": "INTAFACED React customer wrapper. Verified HTTPS origin required. Sideload / WebView. Not store-listed.",
  "scripts": {
    "build": "node ./scripts/build-wrap.mjs",
    "test": "node ./scripts/build-wrap.mjs --check && node --test ./scripts/build-wrap.test.mjs",
    "verify:origin": "node ./scripts/build-wrap.mjs --verify",
    "native:sync": "node ./scripts/build-wrap.mjs && cap sync"
  },
  "dependencies": {
    "@capacitor/android": "8.5.2",
    "@capacitor/core": "8.5.2",
    "@capacitor/ios": "8.5.2"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.0"
  }
}
