{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "globalDependencies": ["tsconfig.base.json", ".env", "tooling/ci/test-typecheck.mjs"],
  "globalEnv": [
    "NODE_ENV",
    "APP_ENV",
    "CI",
    "REQUIRE_POSTGRES",
    "TEST_DATABASE_URL",
    "TEST_DATABASE_URL_PAY",
    "TEST_DATABASE_URL_IDENTITY",
    "TEST_DATABASE_URL_TOKEN",
    "TEST_DATABASE_URL_TRADE",
    "TEST_DATABASE_URL_P2P",
    "TEST_DATABASE_URL_BANK",
    "TEST_DATABASE_URL_BLUEPRINT",
    "TEST_DATABASE_URL_AGENTS",
    "TEST_DATABASE_URL_NOTIFY",
    "TEST_DATABASE_URL_SUPPORT",
    "TEST_DATABASE_URL_SUPPORT_ADMIN",
    "REDIS_URL",
    "NATS_URL",
    "REQUIRE_EVM_CHAIN",
    "PROTOCOL_RPC_URL"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "@intafaced/sbe-codec#build:jar": {
      "dependsOn": [],
      "cache": false,
      "outputs": []
    },
    "@intafaced/svc-matching#test": {
      "dependsOn": ["^build", "@intafaced/sbe-codec#build:jar"],
      "outputs": ["coverage/**"],
      "cache": false,
      "env": ["INTAFACED_RUN_ID", "INTAFACED_INFRA_JOURNAL", "REQUIRE_PAY_EVM"]
    },
    "@intafaced/svc-ws#test": {
      "dependsOn": ["^build", "@intafaced/sbe-codec#build:jar"],
      "outputs": ["coverage/**"],
      "cache": false,
      "env": ["INTAFACED_RUN_ID", "INTAFACED_INFRA_JOURNAL", "REQUIRE_PAY_EVM"]
    },
    "@intafaced/sdk-ts#test": {
      "dependsOn": ["^build", "@intafaced/svc-pay#build"],
      "outputs": ["coverage/**"],
      "cache": false,
      "env": ["INTAFACED_RUN_ID", "INTAFACED_INFRA_JOURNAL", "REQUIRE_PAY_EVM"]
    },
    "@intafaced/sbe-codec#test": {
      "dependsOn": ["^build", "@intafaced/sbe-codec#build:jar"],
      "outputs": ["coverage/**"],
      "cache": false,
      "env": ["INTAFACED_RUN_ID", "INTAFACED_INFRA_JOURNAL", "REQUIRE_PAY_EVM"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "lint": {
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"],
      "cache": false,
      "env": ["INTAFACED_RUN_ID", "INTAFACED_INFRA_JOURNAL", "REQUIRE_PAY_EVM"]
    },
    "test:watch": {
      "cache": false,
      "persistent": true
    },
    "db:generate": {
      "cache": false,
      "outputs": ["drizzle/**"]
    },
    "db:migrate": {
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "clean": {
      "cache": false
    }
  }
}
