{
  "name": "@intafaced/svc-trade",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "node --input-type=module -e \"import {existsSync} from 'node:fs'; process.exit(['auth','config','contracts','db','events','exchange-contract','greeks-adapter','ledger-client','telemetry','venue-adapter','venue-contracts'].some((n)=>!existsSync('../../packages/'+n+'/dist/index.d.ts'))?1:0)\" || pnpm --filter @intafaced/svc-trade^... run --if-present build && tsc -p tsconfig.json --noEmit && node ../../tooling/ci/test-typecheck.mjs",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "tsx scripts/migrate.ts",
    "clean": "rimraf dist .turbo",
    "order-path-smoke": "node ./scripts/order-path-smoke.mjs"
  },
  "dependencies": {
    "@intafaced/auth": "workspace:*",
    "@intafaced/config": "workspace:*",
    "@intafaced/contracts": "workspace:*",
    "@intafaced/db": "workspace:*",
    "@intafaced/events": "workspace:*",
    "@intafaced/exchange-contract": "workspace:*",
    "@intafaced/greeks-adapter": "workspace:*",
    "@intafaced/ledger-client": "workspace:*",
    "@intafaced/telemetry": "workspace:*",
    "@intafaced/venue-adapter": "workspace:*",
    "@intafaced/venue-contracts": "workspace:*",
    "@opentelemetry/api": "^1.10.0",
    "@trpc/server": "^11.19.0",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.7",
    "postgres": "^3.4.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "11.14.0",
    "@types/node": "^22.20.5",
    "fast-check": "^4.10.2",
    "rimraf": "^6.0.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^4.1.12"
  }
}
