{
  "name": "@intafaced/svc-identity",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "node ../svc-ledger/ensure-workspace-types.mjs && tsc -p tsconfig.json --noEmit && node ../../tooling/ci/test-typecheck.mjs",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "tsx scripts/migrate.ts",
    "founder:invites": "tsx scripts/founder-invites.ts",
    "clean": "rimraf dist .turbo"
  },
  "dependencies": {
    "@intafaced/auth": "workspace:*",
    "@intafaced/config": "workspace:*",
    "@intafaced/contracts": "workspace:*",
    "@intafaced/db": "workspace:*",
    "@intafaced/events": "workspace:*",
    "@intafaced/i18n": "workspace:*",
    "@intafaced/ledger-client": "workspace:*",
    "@intafaced/telemetry": "workspace:*",
    "@opentelemetry/api": "^1.10.0",
    "@simplewebauthn/server": "14.0.3",
    "@trpc/server": "^11.19.0",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.7",
    "postgres": "^3.4.5",
    "viem": "^2.57.10",
    "zod": "^4.6.7"
  },
  "optionalDependencies": {
    "@node-rs/argon2": "^2.2.2"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "rimraf": "^6.0.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^3.0.5"
  }
}
