    "@intafaced/telemetry": "workspace:*",
    "@intafaced/venue-adapter": "workspace:*",
    "@opentelemetry/api": "^1.10.0",
    "@trpc/server": "^11.19.0",
    "fastify": "^5.12.7",
    "viem": "^2.57.10",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "rimraf": "^6.0.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^3.0.5"
  }
}
