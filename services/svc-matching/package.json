{
  "name": "@intafaced/svc-matching",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "node ../svc-ledger/ensure-workspace-types.mjs && tsc -p tsconfig.json --noEmit && node ../../tooling/ci/test-typecheck.mjs",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "pnpm --filter @intafaced/sbe-codec run build:jar && vitest run",
    "test:watch": "vitest",
    "clean": "rimraf dist .turbo"
  },
  "dependencies": {
    "@intafaced/auth": "workspace:*",
    "@intafaced/config": "workspace:*",
    "@intafaced/contracts": "workspace:*",
    "@intafaced/events": "workspace:*",
    "@intafaced/exchange-contract": "workspace:*",
    "@intafaced/i18n": "workspace:*",
    "@intafaced/ledger-client": "workspace:*",
    "@intafaced/sbe-codec": "workspace:*",
    "@intafaced/telemetry": "workspace:*",
    "@opentelemetry/api": "^1.10.0",
    "fastify": "^5.12.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "rimraf": "^6.0.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^3.0.5"
  }
}
