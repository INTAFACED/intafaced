{
  "name": "@intafaced/svc-fix",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "description": "FIX gateway adapter. QuickFIX/J 3.0.2 dictionary/session only. Not a book. Not a ledger.",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && node ../../tooling/ci/test-typecheck.mjs",
    "test": "node scripts/run-mvn.mjs test && vitest run",
    "test:watch": "vitest",
    "start": "node scripts/run-acceptor.mjs",
    "adapt": "node scripts/run-adapter.mjs",
    "clean": "rimraf dist .turbo target"
  },
  "dependencies": {
    "@intafaced/contracts": "workspace:*",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "rimraf": "^6.0.1",
    "typescript": "^5.7.2",
    "vitest": "^3.0.5"
  }
}
