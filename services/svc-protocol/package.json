{
  "name": "@intafaced/svc-protocol",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "node --input-type=module -e \"import {existsSync} from 'node:fs'; process.exit(['auth','config','contracts','db','events','telemetry'].some((n)=>!existsSync('../../packages/'+n+'/dist/index.d.ts'))?1:0)\" || pnpm --filter @intafaced/svc-protocol^... run --if-present build && tsc -p tsconfig.json --noEmit && node ../../tooling/ci/test-typecheck.mjs",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:forge": "node scripts/forge-test.mjs",
    "test:watch": "vitest",
    "db:migrate": "tsx scripts/migrate.ts",
    "contracts:build": "node scripts/compile-contracts.mjs",
    "chain:deploy": "tsx scripts/deploy-dev.ts",
    "chain:deploy-sepolia": "tsx scripts/deploy-sepolia.ts",
    "chain:deploy-sepolia-vesting": "tsx scripts/deploy-sepolia-vesting.ts",
    "clean": "rimraf dist .turbo"
  },
  "dependencies": {
    "@intafaced/auth": "workspace:*",
    "@intafaced/config": "workspace:*",
    "@intafaced/contracts": "workspace:*",
    "@intafaced/db": "workspace:*",
    "@intafaced/events": "workspace:*",
    "@intafaced/telemetry": "workspace:*",
    "@noble/curves": "2.4.0",
    "@opentelemetry/api": "^1.10.0",
    "@trpc/server": "^11.19.0",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.7",
    "postgres": "^3.4.5",
    "viem": "^2.57.10",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "drizzle-kit": "^0.31.11",
    "rimraf": "^6.0.1",
    "solc": "0.8.28",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^3.0.5"
  }
}
