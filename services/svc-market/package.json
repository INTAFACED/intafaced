{
  "name": "@intafaced/svc-market",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && node ../../tooling/ci/test-typecheck.mjs",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "tsx scripts/migrate.ts",
    "clean": "rimraf dist .turbo"
  },
  "dependencies": {
    "@intafaced/auth": "workspace:*",
    "@intafaced/config": "workspace:*",
    "@intafaced/contracts": "workspace:*",
    "@intafaced/db": "workspace:*",
    "@intafaced/i18n": "workspace:*",
    "@intafaced/ledger-client": "workspace:*",
    "@intafaced/telemetry": "workspace:*",
    "@opentelemetry/api": "^1.9.0",
    "@trpc/server": "^11.19.0",
    "fastify": "^5.12.5",
    "postgres": "^3.4.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "11.14.0",
    "@types/node": "^22.10.2",
    "rimraf": "^6.0.1",
    "tsx": "^4.23.12",
    "typescript": "^5.7.2",
    "vitest": "^3.0.5"
  }
}
