    "@intafaced/connect-data-lake": "workspace:*",
    "@intafaced/contracts": "workspace:*",
    "@intafaced/i18n": "workspace:*",
    "@intafaced/quant-honesty": "workspace:*",
    "@intafaced/telemetry": "workspace:*",
    "@opentelemetry/api": "^1.10.0",
    "fastify": "^5.12.7",
    "postgres": "^3.4.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "rimraf": "^6.0.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^3.0.5"
