{
  "name": "@intafaced/svc-ops",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && node ../../tooling/ci/test-typecheck.mjs",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rimraf dist .turbo",
    "db:migrate": "tsx src/db/migrate.ts"
  },
  "dependencies": {
    "@intafaced/auth": "workspace:*",
    "@intafaced/config": "workspace:*",
    "@intafaced/contracts": "workspace:*",
    "@intafaced/telemetry": "workspace:*",
    "@trpc/server": "^11.19.0",
    "fastify": "^5.12.7",
    "zod": "^3.24.1",
    "@intafaced/db": "workspace:*",
    "postgres": "^3.4.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "rimraf": "^6.0.1",
    "tsx": "^4.23.15",
    "typescript": "^5.7.2",
    "vitest": "^5.0.5"
  }
}
