# INTAFACED — local development environment
#
#   cp .env.example .env
#
# Never commit .env. Prod secrets come from vault (§9).
#
# ── READ THIS FIRST: the two fleet-wide secrets ──────────────────────────────
#
# EDGE_PRINCIPAL_SECRET and INTERNAL_SERVICE_SECRET are declared ONCE, near the
# top, and every service reads the same variable. They are not per-service
# values and there is no reason ever to have two of either:
#
#   · EDGE_PRINCIPAL_SECRET is the HMAC key over the principal the edge
#     forwards. The edge signs with it; each mounting service verifies with it.
#     Two different values means every authenticated request 401s.
#
#   · INTERNAL_SERVICE_SECRET is the shared secret on the internal money plane.
#     svc-ledger checks it; the six services that post to the ledger send it.
#     Two different values means every `ledger.post` 401s — a platform that
#     starts, looks healthy, and cannot move a single unit of value.
#
# Both are `z.string().min(32)` with NO default (packages/config/src/env.ts), so
# a service that has not been given one refuses to boot. `docker-compose.apps.yml`
# refuses to start at all. That is the design: this is a class of failure that
# must be loud at boot, never discovered at 3am inside a ledger post.
#
# Generate real ones with:  openssl rand -base64 48

EDGE_PRINCIPAL_SECRET=dev-only-edge-secret-at-least-32-chars-long
INTERNAL_SERVICE_SECRET=dev-only-internal-service-secret-at-least-32-chars

# ── svc-matching operators — REQUIRED, or the matching engine will not start ──
#
# MATCHING_OPERATOR_IDS is a comma-separated list of user ids (spaces around a
# comma are ignored, case is ignored). It must name at least TWO DISTINCT ids:
# one operator requests a halt or a market opening, a different one approves it.
# With fewer than two, svc-matching refuses to boot (services/svc-matching/src/env.ts),
# so no spot order can be matched.
# docker-compose.apps.yml passes this variable through from .env.
#
# Left blank on purpose: svc-matching refuses to boot until you set two real operator user ids. local-test-stack sets its own.
MATCHING_OPERATOR_IDS=

# ── svc-ledger reconcile cadence — REQUIRED, or svc-ledger will not start ────
#
# RECONCILE_CRON_MINUTES is how often the ledger proves its books, in whole
# minutes (1 or more). Blank or unset refuses boot (services/svc-ledger/src/env.ts),
# and without the ledger no value moves. docker-compose.apps.yml passes it through
# from .env with no default, because the cadence is the owner's to publish.
#
# Left blank on purpose: set it yourself (60 is the hourly cadence the spec names).
RECONCILE_CRON_MINUTES=

# ── svc-matching snapshot cadence — REQUIRED, or svc-matching will not start ──
#
# MATCHING_SNAPSHOT_EVERY is how many engine events go between snapshots (0
# disables snapshots). Blank or unset refuses boot (services/svc-matching/src/env.ts),
# because the cadence is the owner's to publish.
#
# Left blank on purpose: the spec (§5.1) says "every N events" and names no N. Set it yourself; 0 disables snapshots.
MATCHING_SNAPSHOT_EVERY=

# ── Other settings that refuse boot while blank — REQUIRED ───────────────────
#
# Each is passed through blank by docker-compose.apps.yml (or, for the two EDGE_RATE_LIMIT ones,
# refused by compose itself), and the service that reads it refuses to boot on a blank value.
# Every one is an owner-published limit, cadence or chain setting: nothing in the repo
# supplies a value, so set each yourself. `pnpm platform:up` stops until they are all set.
# docs/SERVICES.md lists the required settings of every service.
#
# svc-edge (compose refuses to start while the first two are blank)
EDGE_RATE_LIMIT_MAX=
EDGE_RATE_LIMIT_WINDOW_MS=
EDGE_BODY_LIMIT_BYTES=
# Host values that address the sandbox (host[:port], comma list). Blank: every sandbox key is refused.
EDGE_SANDBOX_HOSTS=
# svc-bank
LOAN_QUOTE_ASSET_ID=
LOAN_SWEEP_BATCH_SIZE=
TRANSFER_BATCH_SIZE=
# svc-indexer (INDEXER_CHAIN_ID is read from PROTOCOL_CHAIN_ID)
INDEXER_RPC_URL=
INDEXER_VENUE_ADDRESS=
INDEXER_START_HEIGHT=
INDEXER_FINALITY_DEPTH=
INDEXER_BATCH_SIZE=
# The optional AI gateway is behind the `ai` profile, but compose reads the whole file, so it also
# refuses to load while these two are blank. Any non-empty value lets compose load; the gateway only
# runs when you start the `ai` profile (see docs/AI-GATEWAY-SOCKET.md).
LITELLM_CONFIG_PATH=
LITELLM_MASTER_KEY=

# ── Service-to-service keys (S2S v3) — optional, default off ─────────────────
#
# Leave these unset. Services then keep accepting INTERNAL_SERVICE_SECRET.
# S2S_AUTH_MODE=off|dual|keypair   (dual is refused in production posture)
# S2S_KEYRING=                     public keys only
# S2S_SIGNING_KID=
# S2S_SIGNING_KEY=                 secret; deploy environment only, never here
# See services/svc-ledger/CALLER-BINDING.md.

# ── Runtime ──────────────────────────────────────────────────────────────────
NODE_ENV=development
APP_ENV=dev
LOG_LEVEL=info

# §11 — the drop sequence is configuration. 0 · I · II · III · IV · V
LAUNCH_DROP=0

# ── Data ─────────────────────────────────────────────────────────────────────
# Each service connects with its OWN role and sees only its own schema.
# Format: postgres://svc_<name>:svc_<name>@localhost:5433/intafaced
# Host port is 5433 — a native Postgres usually owns 5432. Override the host
# side with POSTGRES_HOST_PORT if 5433 is taken on your machine too.
#
# NOTE: these host-facing values are for processes you run on the HOST
# (`pnpm dev`, `vitest`, a psql session). Containers started by
# docker-compose.apps.yml do not read them — compose gives each service its own
# `postgres://svc_x:svc_x@postgres:5432/...` because inside the compose network
# the host is `postgres` and the port is 5432. See docs/RUNNING.md.
DATABASE_URL=postgres://intafaced_ops:intafaced_ops@localhost:5433/intafaced
# Tests that APPLY MIGRATIONS must use a dedicated DB — never the shared `intafaced`
# schema on 5433 (a branch once broke main's tests from another worktree that way).
# Compose creates `intafaced_test` via tooling/infra/postgres-init/02-intafaced-test-db.sh.
TEST_DATABASE_URL=postgres://intafaced_ops:intafaced_ops@localhost:5433/intafaced_test
TEST_DATABASE_URL_TRADE=postgres://svc_trade:svc_trade@localhost:5433/intafaced_test
# EVERY Postgres suite gets a line here. A suite whose variable is missing does
# not fail — it falls back to a default, and for a long time those defaults were
# the SHARED `intafaced` database. That is the exact hazard the comment above
# warns about, and it bites silently:
#
#   · svc-identity's KYC test asks for the oldest 200 pending records and
#     asserts its own new record is among them. The shared database accumulated
#     307 pending rows from other worktrees' runs, so a record created *now*
#     sorts past the window and the test fails with an assertion that looks
#     exactly like a real regression. Verified 59/59 green on intafaced_test,
#     58/59 on the shared database.
#   · svc-bank's §0.6 custody test reads the live schema and asserts no
#     undeclared money columns exist. An unmerged branch's `loan_*` tables,
#     applied to the shared database from another checkout, made `main` look
#     like it violated custody doctrine. 83/83 green on intafaced_test.
#
# Two further defences now exist so a stale .env cannot resurrect this:
#   1. every suite's code default is a *_test database, not `intafaced`;
#   2. `assertTestDatabase` (packages/db) asks Postgres for current_database()
#      and refuses to run unless the name ends in `_test`.
# This file is still the thing that makes a clean clone correct on first run.
TEST_DATABASE_URL_IDENTITY=postgres://svc_identity:svc_identity@localhost:5433/intafaced_test
TEST_DATABASE_URL_PAY=postgres://svc_pay:svc_pay@localhost:5433/intafaced_test
TEST_DATABASE_URL_TOKEN=postgres://svc_token:svc_token@localhost:5433/intafaced_test
TEST_DATABASE_URL_P2P=postgres://svc_p2p:svc_p2p@localhost:5433/intafaced_test
# These three were read by tooling/ci/assert-test-db-env.mjs and by their
# suites, but had no line here at all.
TEST_DATABASE_URL_BANK=postgres://svc_bank:svc_bank@localhost:5433/intafaced_test
TEST_DATABASE_URL_BLUEPRINT=postgres://svc_blueprint:svc_blueprint@localhost:5433/intafaced_test
TEST_DATABASE_URL_AGENTS=postgres://svc_agents:svc_agents@localhost:5433/intafaced_test
DATABASE_POOL_MAX=10
DATABASE_SSL=false

# ── Optional investor outreach stack (docker-compose.outreach.yml) ────────────
# This overlay requires actual owner-reviewed identities/configuration and
# dedicated keys; no sample founder IDs, secrets, pool values, provider URL, or
# public copy are supplied here. For local development only, the Postgres init
# script creates svc_ops / ops on a fresh data volume. Existing volumes need the
# documented privileged setup in docs/RUNNING.md. Production credentials come
# from the production secret manager; local dev credentials are not production
# guidance.
#
# Required in the operator-owned .env before using the outreach overlay:
# IDENTITY_FOUNDER_NITRO_USER_ID
# IDENTITY_FOUNDER_PHANTOM_USER_ID
# Founder enrolment (auth.registerFounder): sha256 hashes of two single-use invites, plus their expiry.
# Made by `pnpm --filter @intafaced/svc-identity founder:invites`. Unset = enrolment closed. Never commit real values.
# IDENTITY_FOUNDER_INVITE_HASHES
# IDENTITY_FOUNDER_INVITE_EXPIRES_AT
# IDENTITY_EDGE_AUTHORITY_SECRET
# IDENTITY_WS_AUTHORITY_SECRET
# IDENTITY_PAY_ADMISSION_SECRET
# IDENTITY_TRADE_ADMISSION_SECRET
# OPS_DATABASE_URL (container URL for the dedicated svc_ops role/schema)
# OPS_DATABASE_POOL_MAX (positive integer, selected by the database owner)
# OPS_OUTREACH_CONFIG (exact JSON matching the svc-ops README; founders ordered Nitro then Phantom)
# Approved outreach retention member: {"publishedPolicy":"six_calendar_months_v1","automationEnabled":true}
# Enable only with the live erasure dependency and <=30-day encrypted outreach
# backups configured. The 30-day active-discussion review is a separate clock;
# it neither renews meaningful contact nor configures backup disposal.
# OPS_NOTIFY_SERVICE_SECRET (one operator input; mapped to both service env names, distinct from fleet keys)
# NOTIFY_EMAIL_GATEWAY_URL, NOTIFY_EMAIL_GATEWAY_TOKEN, NOTIFY_REQUIRED_CHANNELS (includes email)
# ADMIN_ORIGIN (HTTPS) and ADMIN_SESSION_SECRET (canonical 32-byte base64url)
# OUTREACH_CONTACT_URL and OUTREACH_RETENTION_NOTICE (approved public build values)
# Approved contact: mailto:privacy@intafaced.com (owned; actual mailbox receipt must be verified).
# Publish the approved six-month / 30-day notice only with demonstrated runtime
# and backup enforcement. Build substitution alone is not enforcement.
#
# Optional: OPS_TRUSTED_PROXY_CIDRS; OPS_OUTREACH_RESTORE_QUARANTINED=1 only during
# a quarantined restore. Do not pass restore mode during normal service runtime.

# ── Analytics warehouse read replicas (TRK-ops.analytics Stage-1) ────────────
# Read-only only. Usernames MUST include a marker: _ro / readonly / analytics_ro /
# replica_ro. Never point these at svc_ledger / svc_trade / intafaced_ops writers.
# Leave unset → queryWarehouseSurface returns unavailable (honest empty), never invent KPIs.
# See docs/runbooks/ANALYTICS-WAREHOUSE-REPLICA-RUNBOOK.md and
# docs/adr/2026-08-07-ops-analytics-warehouse-read-replica.md
# ANALYTICS_REPLICA_LEDGER_URL=postgres://analytics_ro:change-me@localhost:5433/intafaced
# ANALYTICS_REPLICA_TRADE_URL=postgres://analytics_ro:change-me@localhost:5433/intafaced
# ANALYTICS_REPLICA_IDENTITY_URL=postgres://analytics_ro:change-me@localhost:5433/intafaced
# Optional dry-run without URLs (fixture surface only). Prefer URLs above.
# ANALYTICS_REPLICA_CONFIGURED=true
# Operator-typed lag seconds — lagSource=configured; NEVER alone claims mayLabelLive.
# Prefer a probe of pg_last_xact_replay_timestamp (ANALYTICS_REPLICA_LAG_SQL in contracts).
# ANALYTICS_REPLICA_LAG_SECONDS=5
# Operator-stamped last ETL success (ISO-8601). Unset/junk → absent; never paints live cubes alone.
# ANALYTICS_ETL_WATERMARK_AT=2026-08-12T10:00:00.000Z

REDIS_URL=redis://localhost:6380

NATS_URL=nats://localhost:4222
NATS_STREAM_PREFIX=INTAFACED

# ── Observability (§9) ───────────────────────────────────────────────────────
OTEL_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# Grafana: http://localhost:3001  (intafaced / intafaced)

# ── Auth (§4.1 · svc-identity) ───────────────────────────────────────────────
# Minimum 32 characters. Generate: openssl rand -base64 48
JWT_ACCESS_SECRET=dev-only-signing-secret-replace-me-before-anything-real
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000
# Seconds a just-rotated refresh token may be presented again by a second tab. 0 disables.
REFRESH_REUSE_GRACE_SECONDS=10
JWT_ISSUER=intafaced
JWT_AUDIENCE=intafaced.api
REGISTRATION_OPEN=true
# Owner-published max *live* (non-revoked) sub-accounts per identity (D-S-11 §4/§8).
IDENTITY_MAX_SUB_ACCOUNTS=25
# Owner values for the sign-in challenge (I-signin-sessions-30), no defaults. AFTER_FAILURES is the count of failed
# sign-ins per address before a challenge is asked; blank asks one at every sign-in. BITS (difficulty), TTL_SECONDS and
# KEY (a secret; deploy environment only, never here) left blank refuse every password sign-in, founders included, with
# identity.challenge_unconfigured. Set all four before any deploy that is not the local stack.
# IDENTITY_SIGNIN_CHALLENGE_AFTER_FAILURES=
# IDENTITY_SIGNIN_CHALLENGE_BITS=
# IDENTITY_SIGNIN_CHALLENGE_TTL_SECONDS=
# IDENTITY_SIGNIN_CHALLENGE_KEY=                 secret; deploy environment only, never here
# svc-pay base for the owner pay-scope grant and for claiming a merchant email
# invite once the mailbox is confirmed. Unset: sign-in still works and the
# invite stays pending. No localhost default.
# PAY_URL=http://127.0.0.1:4006

# ── Founder access on the LOCAL Docker stack (docs/RUNNING.md) ───────────────
# Customer app http://localhost:8090 · founder console http://localhost:3100.
# Easiest path: `INTAFACED_LOCAL_FOUNDER=1 pnpm local:founder init` writes every value below into
# .env.founder.local (git-ignored) with fresh random secrets, then
# `docker compose --env-file .env --env-file .env.founder.local -f docker-compose.apps.yml up -d --build`.
# Or fill them by hand here. All blank = founder console refuses everyone.
#
# TOTP secrets at rest (32-byte AES key, base64). Blank = nobody can enrol TOTP.
# generate with: openssl rand -base64 32
IDENTITY_TOTP_SECRET_KEY=
#
# Access-token signing keys for rotation: id:secret,id2:secret2 (secrets 32+ chars; the id "legacy" is JWT_ACCESS_SECRET).
# Blank = rotation refuses. Every service that checks tokens must carry the same ring before a rotation is run.
IDENTITY_AUTH_KEYS=
# Key that hides the address in password-reset and username-recovery flows (32 bytes, base64).
# Blank = reset and recovery refuse (auth.reset_unwired).
IDENTITY_FLOW_SUBJECT_KEY=
#
# Founder console session key (32 bytes, base64url, exactly 43 characters).
# generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ADMIN_SESSION_SECRET=
# Exact browser origin of the console. Left blank on purpose (blank = console refuses
# every login). The local seed writes http://localhost:3100 into .env.founder.local;
# http is accepted ONLY with APP_ENV=dev/test and a localhost host, staging and
# production need the real https origin.
# ADMIN_ORIGIN=
#
# Passkeys: the origin must equal the page's origin and the RP ID its host name.
# Use http://localhost:8090 (NOT 127.0.0.1: an IP address cannot be a passkey RP ID;
# password sign-in works on either). Comma-separated list. Staging and production
# refuse localhost / non-https values, so this line cannot reach production.
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:8090,http://localhost:3100
#
# Founder pair: the two existing user UUIDs, set only after both founders have a
# second factor. `pnpm local:founder enrol` writes these for you.
# IDENTITY_FOUNDER_NITRO_USER_ID=
# IDENTITY_FOUNDER_PHANTOM_USER_ID=
# Single-use enrolment invites (sha256 hashes + expiry; the codes are never
# configured). generate with: pnpm --filter @intafaced/svc-identity founder:invites
# or `INTAFACED_LOCAL_FOUNDER=1 pnpm local:founder init`. Blank = founder enrolment closed.
# IDENTITY_FOUNDER_INVITE_HASHES=
# IDENTITY_FOUNDER_INVITE_EXPIRES_AT=
# Kill-switch / ledger-freeze reads in the console need these (optional, blank = "unconfigured"):
# see the "apps/admin" section below (ADMIN_OPERATOR_TOKEN, ADMIN_TREASURY_TOKEN).
# D26-P0-02 (2026-08-13): affiliate accrual tiers — hops 0–2, share of house fee.
# Malformed JSON fails svc-identity boot. Blank would refuse accrue (rates_unset).
IDENTITY_AFFILIATE_ACCRUAL_TIERS_JSON={"published":true,"tiers":[{"hop":0,"rate":"0.10"},{"hop":1,"rate":"0.05"},{"hop":2,"rate":"0.02"}]}

# ── Payments (§6.1 · svc-pay) ────────────────────────────────────────────────
# Webhook signing secrets, minimum 32 characters, no defaults in the schema.
# A forged delivery on either endpoint says "this payment was captured" about
# money that never moved — so an unset secret fails startup rather than quietly
# verifying everything. Sandbox money is still a real state machine.
PAY_CRYPTO_WEBHOOK_SECRET=dev-only-crypto-webhook-secret-at-least-32-chars
PAY_CARD_SANDBOX_WEBHOOK_SECRET=dev-only-card-webhook-secret-at-least-32-chars
# Merchant controls (caps, pricing, payout approval). Blank or off refuses boot unless APP_ENV is exactly dev or test.
# Use required for every real deployment, after the pre-enable checklist in services/svc-pay/src/control/README.md.
PAY_MERCHANT_CONTROLS=
# Reorg depth. Blank refuses boot — never a schema default of 6. This 6 is owner-explicit.
PAY_MIN_CONFIRMATIONS=6
# Signed-webhook replay window (seconds). Blank refuses boot — never a schema default of 300. This 300 is owner-explicit.
PAY_WEBHOOK_TOLERANCE_SECONDS=300
# Hosted checkout session (seconds). Blank refuses boot — never a schema default of 900. This 900 is owner-explicit.
PAY_CHECKOUT_SESSION_TTL_SECONDS=900
# Open checkout sessions per link. Blank refuses boot — never a schema default of 25. This 25 is owner-explicit.
PAY_CHECKOUT_MAX_OPEN_SESSIONS=25
# Payment-link default lifetime (days). Blank refuses boot — never a schema default of 30. This 30 is owner-explicit.
PAY_LINK_DEFAULT_TTL_DAYS=30
# Payment-link max lifetime (days). Blank refuses boot — never a schema default of 365. This 365 is owner-explicit.
PAY_LINK_MAX_TTL_DAYS=365
# Operator-credit allow-list. Blank refuses boot — never a schema default of card-sandbox. This card-sandbox is owner-explicit.
PAY_OPERATOR_CREDIT_RAILS=card-sandbox
# Email team invites. All three must be positive integers or sending refuses
# and a claim binds nothing. No default count, window, or lifetime.
# Account-id invites do not use this.
# PAY_TEAM_EMAIL_INVITE_MAX=
# PAY_TEAM_EMAIL_INVITE_WINDOW_MS=
# PAY_TEAM_EMAIL_INVITE_TTL_MS=

# LIVE crypto-native rail (optional). When unset: MemoryChain in dev/test,
# UnconfiguredChain in staging/prod. When set, ALL of the following are required
# and crypto-native becomes mode=live (real JSON-RPC, real txHashes).
# Local proof against compose `evm` (anvil). The signer holds no key in settings.
# PAY_CRYPTO_RPC_URL=http://127.0.0.1:8545
# PAY_CRYPTO_CHAIN_ID=31337
# PAY_CRYPTO_DEPOSIT_SOURCE=testnet
# PAY_CRYPTO_SIGNER=testnet
# PAY_CRYPTO_ASSETS=ETH:native
# PAY_REGISTER_CARD_SANDBOX=false
# PAY_CRYPTO_WATCHER_ENABLED=true
# PAY_CRYPTO_WATCHER_INTERVAL_MS=2000

# ── Native asset (§4.3 · svc-token, svc-bank) ────────────────────────────────
TOKEN_ASSET_ID=IFC

# Loan/earn recovery timer (svc-bank). Unset uses 60000 and 50, the same
# defaults as the trade hold-unknown sweep. Set either value empty to disable
# the timer; svc-bank logs a startup warning. Do not invent 100.
# BANK_RECOVERY_JOBS_INTERVAL_MS=60000
# BANK_RECOVERY_JOBS_BATCH_LIMIT=50

# ── Cards (§8.1 · svc-bank, the LEDGER half only) ────────────────────────────
# `none` is the default and it is a STATEMENT, not a disabled feature: this
# deployment has no card programme, and every card procedure refuses
# `bank.no_card_issuer` by name rather than pretending otherwise.
#
# The only other value is `card-sim`, and it is A SIMULATOR. It issues no card,
# talks to no scheme, holds no issuing BIN, and makes no network call. What it
# does is let the ledger half run end to end — authorise, hold, capture, reverse,
# cashback — against real postings in the real book, with `simulated: true` on
# the programme, on every card and on every response. `/ready` reports which of
# the two is in force, so nobody has to trust this file to find out.
#
# There is no third value. A LIVE card rail is §13 `socket.live-issuer`: a
# card-scheme sponsor and an issuing BIN, which is a licence and a commercial
# relationship. No environment variable produces one.
BANK_CARD_ISSUER=none

# ── Blueprint (§7.1 · svc-blueprint) ─────────────────────────────────────────
# The Neural Engine is an external deployment a clean clone does not have, so
# the default is the deterministic in-process engine. It is a MODE, not a
# fallback: pointing `http` at nothing would serve stub profiles to real people
# while reporting healthy.
BLUEPRINT_ENGINE_MODE=mock
# BLUEPRINT_ENGINE_URL=http://host.docker.internal:4108
# BLUEPRINT_ENGINE_API_KEY=

# ── Protocol Plane (§17.4 · svc-protocol) ────────────────────────────────────
# Non-custodial by architecture. Note what is NOT here and must never be added:
# no private key, mnemonic or signer secret — svc-protocol has no transaction it
# is entitled to originate on a user's account (§16.10).
#
# THE COMPOSE STACK NOW RUNS A DEV CHAIN. It is the `evm` service in
# docker-compose.yml: anvil, ephemeral, marked `# no-deploy`, and NOT a decision
# about what chain this platform ships on. That decision is still open.
#
#   docker compose up -d evm
#   pnpm --filter @intafaced/svc-protocol chain:deploy
#
# The two addresses below are what that deploy always produces, because anvil
# starts at genesis with the deployer at nonce 0. Zero them, or stop the `evm`
# service, and svc-protocol goes back to refusing every chain-dependent path
# with a typed 503 — the correct behaviour, not a degraded one.
# `protocol.chainStatus` verifies with `eth_getCode`, so a configured address
# never implies a deployed contract.
#
# From a container the RPC is `http://evm:8545`; from your machine it is
# `http://127.0.0.1:8545`. `host.docker.internal` still works if you would
# rather run your own node.
# Named local Anvil. Blank refuses boot — never echo 31337 as live.
PROTOCOL_CHAIN_ID=31337
PROTOCOL_RPC_URL=http://evm:8545
# Host port for the dev chain. Change it if you already run a node on 8545.
EVM_HOST_PORT=8545
# ERC-4337 v0.7 EntryPoint singleton — a public contract, not ours, and NOT
# deployed on the dev chain. Relaying therefore still refuses locally.
PROTOCOL_ENTRYPOINT_ADDRESS=0x0000000071727De22E5E9d8BAf0edAc6f37da032
PROTOCOL_FACTORY_ADDRESS=0xe7f1725E7734CE288F8367e1Bb143E90bb3F0512
PROTOCOL_IMPLEMENTATION_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3
# launch.token-factory (§8.4) — the ERC-20 launch factory, deployed by the same
# `chain:deploy` at nonce 2. Zero it and every launch path refuses with
# `launch.factory_not_configured` instead of deriving a real-looking address for
# a token nothing will ever deploy to.
#
# The template it deploys is in-repo (contracts/launch/SovereignToken.sol) and
# is NOT AUDITED. `protocol.launch.status` reports `audited: false`, and will
# keep doing so until somebody pays for one.
PROTOCOL_TOKEN_FACTORY_ADDRESS=0x9fE46736679d2D9a65F0992F2272dE9f3c7fa6e0
# Optional. Without a bundler the user submits their own operations —
# convenience degrades, access does not.
# PROTOCOL_BUNDLER_URL=http://localhost:4337
PROTOCOL_RELAY_ENABLED=true

# ── Agents (§8.2 · svc-agents) ───────────────────────────────────────────────
# The model provider is DEPLOYMENT CONFIGURATION, never source. Doctrine §0.7
# keeps third-party system names out of everything that ships, and §1 requires
# providers to be swappable — both hold when the endpoint, the credential, the
# headers and the model ids arrive from here. Swapping providers is editing the
# block below and restarting.

# 'mock' is the default on purpose: a developer runs the fleet with no
# credential, and starting the service by accident cannot spend money.
AGENTS_PROVIDER=mock

AGENTS_FEE_ASSET_ID=IFC
# Billing window length. Must divide 1440 so a window never straddles midnight —
# the window id is half of the ledger idempotency key.
AGENTS_USAGE_WINDOW_MINUTES=60
# Kill-switch for billing. Unset refuses boot (agents.metering_enabled_unset).
# Owner may set true. Explicit false is audit-only (no usage_records / feeCharge).
AGENTS_METERING_ENABLED=true

# Required only when AGENTS_PROVIDER=upstream. Prod values come from vault (§9).
# AGENTS_UPSTREAM_BASE_URL=https://engine.internal
# AGENTS_UPSTREAM_API_KEY=replace-me
# AGENTS_UPSTREAM_AUTH_HEADER=x-api-key
# AGENTS_UPSTREAM_AUTH_PREFIX=
# Static headers — protocol version pins, tenant ids.
# AGENTS_UPSTREAM_HEADERS={"x-protocol-version":"2026-01-01"}
# AGENTS_UPSTREAM_COMPLETIONS_PATH=/v1/messages
# AGENTS_UPSTREAM_EMBEDDINGS_PATH=/v1/embeddings
# Routing-table alias -> the concrete model id this upstream accepts.
# AGENTS_UPSTREAM_MODELS={"reasoning-lg":"","reasoning-md":"","fast-sm":"","embed-sm":""}

# ── The AI gateway (docs/AI-GATEWAY-SOCKET.md) ───────────────────────────────
#
# The upstream above can be a provider directly, or ONE PROXY in front of
# several. The proxy is what gives routing, failover, per-key budgets and cost
# accounting without any of it being written into svc-agents — which is the
# whole reason AGENTS_UPSTREAM_* is a URL and not an SDK.
#
# OFF unless you ask for it: the `litellm` service in docker-compose.apps.yml
# sits behind `profiles: ['ai']` and starts only under `--profile ai`.
#
# NO ROUTING TABLE IS COMMITTED. A model list names providers and models, .yaml
# is inside the brand scan's extensions, and §0.7 forbids those names in this
# repo — so the config is a deployment secret you keep OUTSIDE the tree, like
# the provider key it holds. docs/AI-GATEWAY-SOCKET.md §2.1 gives the shape.
#
# LITELLM_CONFIG_PATH=/home/you/.intafaced/secrets/litellm.yaml
# Long random string. svc-agents presents this as its bearer token, so it is
# the only thing standing between the compose network and your provider bill.
# LITELLM_MASTER_KEY=replace-me
# Optional; encrypts stored keys if you use the gateway's own key management.
# LITELLM_SALT_KEY=
#
# Then point the block above at it:
#   AGENTS_PROVIDER=upstream
#   AGENTS_UPSTREAM_BASE_URL=http://litellm:4400
#   AGENTS_UPSTREAM_API_KEY=<the same LITELLM_MASTER_KEY>
#   AGENTS_UPSTREAM_AUTH_HEADER=Authorization
#   AGENTS_UPSTREAM_AUTH_PREFIX='Bearer '
#
# CHECK THE PATH FIRST. AGENTS_UPSTREAM_COMPLETIONS_PATH defaults to
# /v1/messages, which was chosen for a direct provider; the proxy's coverage of
# it has varied by version while /v1/chat/completions has not. It is unverified
# here — docs/AI-GATEWAY-SOCKET.md §3 has the one-line curl that settles it.
# AGENTS_UPSTREAM_TIMEOUT_MS=60000

# Full per-task routing table, overriding the built-in default (which is priced
# for development, not production).
# AGENTS_ROUTING_TABLE={"routes":[{"task":"navigator.plan","providerId":"primary","model":"reasoning-lg","maxOutputTokens":4096,"price":{"inputPerMillion":"3","outputPerMillion":"15"}}]}

# The operator agent log (founder console /more-ops/agents/log). EMPTY ON
# PURPOSE: the owner sets the reasons an operator may pick, how many rows one
# read shows, and how many days a prompt text is kept. Unset refuses every log
# read by its code; 0 days keeps no transcript.
# AGENTS_LOG_READ_REASONS=
# AGENTS_OPS_ACTIONS_LIMIT=
# AGENTS_TRANSCRIPT_RETENTION_DAYS=

# The scanner, navigator and support doors' tier law, as JSON (svc-agents
# tier-laws.ts). EMPTY ON PURPOSE: the owner publishes it. Unset refuses each
# door with tier_law_blank; the tier itself is always the signed principal's.
# AGENTS_TIER_LAWS=

# The own-agent templates the builder offers, comma-separated ids (svc-agents own/catalog.ts). Unset offers every
# built-in template; "blank" alone offers only Start blank, which is always offered.
# AGENTS_OWN_TEMPLATES=

# ── Notifications out of the app (§13 · svc-notify) ──────────────────────────
# EMPTY ON PURPOSE. Filling these in is the owner's job and nobody else's.
#
# Three channels leave the platform — email, push, SMS — and each one is a URL
# and a bearer token. Until both are set, that channel REFUSES every message by
# name (`channel.not_configured`), the refusal is recorded on the delivery row,
# and users still receive everything in the in-app inbox. Nothing is silently
# dropped and nothing reports a send that did not happen.
#
# No provider is named here or in the code (§0.7). Whatever answers the URL is
# the owner's choice; swapping it is an env change, not a release. The contract
# that URL must speak is in services/svc-notify/README.md; the 10-minute version
# of what to obtain is docs/OWNER-ACTIONS-NOTIFY-GATEWAYS.md.
#
# Do not invent a value to make a channel "work". A token that is not real turns
# an honest refusal into a failing send, which is strictly worse.

# NOTIFY_EMAIL_GATEWAY_URL=
# NOTIFY_EMAIL_GATEWAY_TOKEN=
# NOTIFY_PUSH_GATEWAY_URL=
# NOTIFY_PUSH_GATEWAY_TOKEN=
# The push gateway's public application key (URL-safe base64). Browsers need it to subscribe; served only with the URL and token.
# NOTIFY_PUSH_PUBLIC_KEY=
# NOTIFY_SMS_GATEWAY_URL=
# NOTIFY_SMS_GATEWAY_TOKEN=

# Which of those channels this deployment DEPENDS ON: a comma-separated subset
# of email,push,sms — or the literal `none`.
#
# In APP_ENV=staging or prod this has NO DEFAULT and its absence stops the boot,
# and so does listing a channel whose two variables are not set. Same posture as
# EDGE_PRINCIPAL_SECRET: a process that cannot do the job it was deployed for
# does not start and pretend. In dev and test, leaving it unset means "nothing
# required" — no gateway is needed to run the stack or the suite.
# NOTIFY_REQUIRED_CHANNELS=none

# Operator stops. Fan-out off = no inbox rows either; out-of-app off = the inbox
# still fills and nothing leaves the platform (the switch for an incident).
# NOTIFY_FANOUT_ENABLED=true
# NOTIFY_OUT_OF_APP_ENABLED=true

# Attempts per channel before a delivery row is abandoned (1..5). Blank is not 3.
NOTIFY_MAX_DELIVERY_ATTEMPTS=3
# Per-call budget in ms, and the SMS character cap — SMS is billed per segment, so an
# unbounded body is an unbounded bill.
# NOTIFY_GATEWAY_TIMEOUT_MS=5000
# NOTIFY_SMS_MAX_CHARS=480
# Address-confirmation code lifetime (1..120). Blank is not 15.
NOTIFY_VERIFY_TTL_MINUTES=15

# ── Host port overrides ──────────────────────────────────────────────────────
# Only the infrastructure ports are overridable; the application ports are
# fixed in docker-compose.apps.yml because several services would otherwise
# collide with each other (three of them default to 4004 in code).
# POSTGRES_HOST_PORT=5433
# REDIS_HOST_PORT=6380

# ── P2P dispute moderators (svc-p2p) ─────────────────────────────────────────
# Comma-separated lowercase canonical UUIDs of humans who may call
# disputes.list / disputes.resolve with ordinary p2p:read. Empty (default) =
# moderation unreachable — the API honest-refuses rather than faking a ruling
# (D-S-08). admin:compliance still works when a principal holds it.
# P2P_MODERATOR_USER_IDS=

# ── Futures orderability (svc-trade · trade.futures / D-S-01) ────────────────
# DEFAULT OFF, AND OFF IS A PRODUCT STATE RATHER THAN AN OUTAGE.
#
# `false` (the shipped default, also written into docker-compose.apps.yml so the
# answer is visible without reading a zod schema): svc-trade boots normally and
# serves everything it serves today. A futures market may be LISTED — its ticker,
# orderbook and market metadata all answer — and an ORDER into it is refused by
# name with `trade.futures_disabled`, a 403 carrying CCXT `NotSupported`. Not a
# 500, not a crash-loop, and never a reason a cancellation fails: a switch that
# traps funds is not a safety control.
#
# `true`: a futures market accepts orders, matches on the SAME svc-matching book
# as spot (D-S-06 — there is no second book), and fills settle through
# packages/ledger-client like any other fill.
#
# WHAT IT DOES NOT DO. Naming a flag `FUTURES_ENABLED` invites the reading that
# it turns futures on as a product. It does not:
#   · Funding stays off (PKT-B6 2026-08-13). TRADE_FUTURES_JOBS_ENABLED plus an
#     explicit TRADE_FUTURES_FUNDING_MARKET_IDS and TRADE_FUTURES_FUNDING_MAX_ABS_RATE
#     (no product default) are still required to turn a listed market on.
#   · Realised profit uses TRADE_FUTURES_PROFIT_SOURCE (PKT-B5 named in this file).
#     TRADE_FUTURES_ENABLED still does not open futures as a product.
#   · No leverage. An order on a futures book is funded by the same hold as a
#     spot order, in full, so this flag picks no risk parameter. Margin positions
#     remain their own path with their own gate.
#   · Live listing also needs a positive insurance-pot balance (DIRECTION:33).
#     That is a ledger credit, not an env mint. Market-comp new-book seed is
#     1000000 USDT on recipeInsuranceAccount("USDT") — ops, not a git number.
# TRADE_FUTURES_ENABLED=false
#
# Local TEST futures listing (GET /markets). Default OFF. Does not enable
# futures, jobs, or a leverage cap. The seed script refuses a non-local database.
# TRADE_FUTURES_TEST_SEED=false
#
# Residual jobs (liquidation + funding ticks). Default OFF. Compose pins
# `${TRADE_FUTURES_JOBS_ENABLED:-false}` the same way. `true` still does not
# invent a funding schedule: TRADE_FUTURES_FUNDING_MARKET_IDS,
# TRADE_FUTURES_FUNDING_MAX_ABS_RATE, and TRADE_FUTURES_FUNDING_INTERVAL_MS
# remain empty until named (PKT-B6 / D2). Empty interval is not 8h.
# TRADE_FUTURES_JOBS_ENABLED=false
#
# Conditional orders (stop, stop-limit, take-profit, trailing, attached TP/SL).
# Default OFF. Compose pins `${TRADE_FUTURES_CONDITIONAL_JOBS_ENABLED:-false}`.
# An empty interval does not start the timer and is not a cadence.
# TRADE_FUTURES_CONDITIONAL_JOBS_ENABLED=false
# TRADE_FUTURES_CONDITIONAL_JOBS_INTERVAL_MS=
#
# Funding tick interval (ms). EMPTY = do not schedule funding ticks.
# D2: there is no product 8h default. Compose pins
# `${TRADE_FUTURES_FUNDING_INTERVAL_MS:-}` (empty), never 28800000.
# TRADE_FUTURES_FUNDING_INTERVAL_MS=
#
# Venue-mark Connect stream (MaintainedBook). Default OFF. Compose pins
# `${TRADE_VENUE_MARK_STREAM:-false}`. `true` still needs a venue id + symbol
# map; empty map starts nothing and a desynced feed is a null mark, not an invent.
# TRADE_VENUE_MARK_STREAM=false

# ── Futures funding |rate| bound (svc-trade / BUILD-STOP D2 / C12) ────────────
# EMPTY ON PURPOSE. There is no product ceiling number in code.
#
# A published period rate of "1000000" used to charge 1e6 × notional with no
# refuse path. Publish and settlement now refuse when this is unset, and refuse
# when |rate| exceeds the configured absolute max (same units as the period
# rate — absolute decimal, not bps).
#
# REQUIRED at boot when TRADE_FUTURES_FUNDING_MARKET_IDS is non-empty.
# The magnitude itself is owner residual D2 (docs/BUILD-STOP-TRADE-2026-08-08.md, removed)
# — do not invent e.g. 0.01 here and treat it as law.
# TRADE_FUTURES_FUNDING_MAX_ABS_RATE=

# ── Futures max leverage (svc-trade / DIRECTION §1 / D26-P0-07) ──────────────
# EMPTY = code uses 10× (DIRECTION §1 frozen). Set only to tighten (≤ 10).
# A value above 10 is a raise and svc-trade will not boot.
# TRADE_FUTURES_MAX_LEVERAGE=
# Futures orders through svc-matching (slice 6). Off by default; the band is the owner's fraction of the mark, blank refuses.
# TRADE_FUTURES_MATCHING_ENABLED=false
# TRADE_FUTURES_PRICE_BAND=
# Futures symbol = spot symbol pairs whose spot book marks the futures market (blank: the futures book's own mid).
# TRADE_FUTURES_INDEX_SPOT_MARKETS=

# ── Futures realised-profit source (svc-trade) ───────────────────────────────
# D26-P0-02 / PKT-B5 sealed 2026-08-13: owner named the account the recipe
# already draws from. Format `ownerType:ownerId:kind[:purpose]`. Boot still
# EXITS if this spelling is not the futuresRealizeProfit funding leg.
# Blank still disables futures profit (optionalProfitSourceFromConfig → null);
# compose has no default. TRADE_FUTURES_ENABLED stays false; funding stays off.
# ADR: docs/adr/2026-08-13-d26-p0-02-owner-launch-seals.md
TRADE_FUTURES_PROFIT_SOURCE=house:futures-loss:available

# ── Marketplace house commission (svc-market / D26-P0-10 + P0-02 number) ─────
# Owner click 2026-08-13: explicit free-cut. 0 is a published rate, not silence.
# Unset still refuses market.commission_not_configured (no in-code default).
# Compose pass-through only — no ${...:-0}.
MARKET_HOUSE_COMMISSION_BPS=0

# D26-P0-02 copy fee-share (bps of our protocol fee, not of P&L / notional).
TRADE_COPY_FEE_SHARE_LAW={"published":true,"leaderShareBps":1000,"earningsCapPerFollower":"1000.00","decayRoundTrips":50,"decayShareBps":5000}
# D26-P0-15 copy geo — counsel has not supplied a served-jurisdiction list.
# Blank refuses follow creation in every region. Engineers must not seed codes.
# See docs/adr/2026-08-15-copy-jurisdiction-refuse-closed.md.
TRADE_COPY_JURISDICTION_LAW=
# CB-copy-02 what a lead page's metrics mean. Empty shows no metric number.
# The definitions are owner content — do not write one here.
TRADE_COPY_METRIC_DEFINITIONS=
# CB-copy-03 verification level a follower needs: basic, full or institutional.
# Empty refuses every Start copying. Owner and compliance content.
TRADE_COPY_MIN_TIER=

# ── Options settlement asset law (svc-trade / trade.options / D26-P0-05) ─────
# EMPTY BY DEFAULT — and empty means REFUSE listing, not invent settlement law.
#
# listMarket(kind=options) throws trade.options_settlement_law_unset until this
# is a non-empty opaque string meaning the P0-05 ADR is published (live set,
# settlement asset, refuse matrix). The value is NEVER parsed for assets or
# matrix rows — SOCKET §13 socket.options-settlement-asset-law. Stamp only after
# that ADR exists. D7 fixing alone must not unlock options.
# TRADE_OPTIONS_SETTLEMENT_ASSET_LAW=

# ── Options settlement fixing (svc-trade / trade.options / D7) ───────────────
# EMPTY BY DEFAULT — and empty means REFUSE listing, not invent a fixing.
#
# After P0-05 is stamped, listMarket(kind=options) throws
# trade.options_fixing_unconfigured until this is a non-empty opaque string.
# The value is stamped on trade.markets.settlement_fixing; it is never parsed
# for source, window, expiry clock, or funded payor. Those are owner law (D7).
# Half-listed options (missing strike/type/expiry/fixing) are refused in
# service and blocked by markets_options_terms_ck.
#
# No IV surface. No pricing model. Options orders stay refused by assertTradable
# (trade.market_kind_unsupported) until an options engine exists.
# TRADE_OPTIONS_SETTLEMENT_FIXING=

# ── Feature flag overrides ───────────────────────────────────────────────────
# Any flag in packages/config/src/flags.ts can be forced on or off:
#   INTAFACED_FLAG_<KEY_WITH_UNDERSCORES>=on|off
# INTAFACED_FLAG_TRADE_SPOT=on
# INTAFACED_FLAG_BLUEPRINT_ONBOARDING=on

# ── Sanctions / region screening (§24 Lane A) ────────────────────────────────
# EMPTY ON PURPOSE, AND STILL NEEDS COUNSEL.
#
# `checkAccess` has always been able to refuse a region and has never had a list
# to refuse from — so it cleared everyone and reported that as "screened". These
# two variables are how the list gets supplied, and svc-edge now REFUSES TO
# START with APP_ENV=staging or prod while they are unset. Dev and test are
# unaffected: an empty list logs a warning and boots.
#
# Comma-separated ISO-3166 alpha-2 codes, each optionally followed by ":reason".
# The reason is what a refused user sees and what the audit log carries.
#
#   INTAFACED_SANCTIONS_REGIONS="AA:UNSC resolution ref,BB:programme ref"
#
# WHAT GOES IN THE LIST IS A COMPLIANCE DECISION WITH A NAMED OWNER, not an
# engineering one. Do not guess it — too few entries is a sanctions breach, too
# many is unlawful discrimination. The placeholders above are not country codes.
# INTAFACED_SANCTIONS_REGIONS=
#
# Free-text provenance recorded on every screening decision: the governance
# record, counsel memo, or published list revision this came from.
# INTAFACED_SANCTIONS_LIST_SOURCE=

# Request-time refuse when the screening list is unset (D26-P1-O1 mechanism).
# Default OFF: checkAccess still returns allowed with listConfigured=false
# (honesty-only). When ON (1/true/yes/on), hosted access refuses with
# denied.screening_unconfigured — does NOT invent Class X list content.
# INTAFACED_SCREENING_FAIL_CLOSED=

# ── svc-edge: the front door (§9) ────────────────────────────────────────────
# Turns a bearer token into the signed principal every mounted service requires.
# It reuses EDGE_PRINCIPAL_SECRET declared above — do not add a second copy.
#
# JWT_ACCESS_SECRET must match svc-identity's. A mismatch means every login
# succeeds and every request after it is anonymous, which presents to a user as
# "logged in but nothing works" and to an operator as no error at all.
EDGE_HTTP_PORT=4000
# Two-letter code, resolved server-side. XX is the region the jurisdiction
# matrix treats as unknown, so a deployment that forgets this is restrictive
# rather than accidentally open.
DEFAULT_REGION=XX
UPSTREAM_TIMEOUT_MS=15000

# Browser origins allowed to call the edge cross-origin.
#
# UNTIL THIS EXISTED THE EDGE SENT NO CORS HEADERS AT ALL, so no browser call
# from apps/web had ever succeeded — every tRPC call carries an Authorization
# header, which preflights, and a preflight to a server with no CORS layer goes
# nowhere. It presented as "PLATFORM UNREACHABLE" while the edge answered 200.
#
# Comma-separated EXACT origins: scheme://host[:port], no path, no trailing
# slash. A bare `*` is a BOOT FAILURE, not a skipped entry — a wildcard is not
# an allowlist. So is a typo: the process refuses to start rather than serve a
# list that differs from what was written.
#
#   EDGE_ALLOWED_ORIGINS="https://app.example.com,https://www.example.com"
#
# dev/test default to http://localhost:3100 plus its 127.0.0.1 spelling
# (apps/admin under `next dev`), so nobody needs to set a variable to open the
# console they just started. The :3000 pair was deleted with `apps/web` — see the
# DEV_ORIGINS note in services/svc-edge/src/cors.ts; do not re-add it for a dev
# convenience. The :8090 product shell needs no entry at all: nginx serves it
# same-origin and proxies /api by service name. APP_ENV=staging and prod get NO
# default: unset there is a CLOSED DOOR — every front-end is refused by the
# browser and it looks to a user like the platform being down. svc-edge logs
# that at ERROR on boot and reports it on /ready; it does not refuse to start,
# because doing so would take down the server-to-server callers and the
# same-origin :8090 shell, none of which need CORS at all.
#
# NOT the same variable as CORS_ALLOWED_ORIGINS further down. That one is the
# vendored Java shell's and it allows credentials, because the shell uses a
# session cookie. This one never emits Access-Control-Allow-Credentials, because
# its callers hold a token and send it as a header. One name for two postures
# would be one value nobody could reason about.
# EDGE_ALLOWED_ORIGINS=

# Request throttle on the front door (services/svc-edge/src/hardening.ts).
#
# UNTIL THIS EXISTED THE EDGE COUNTED NOTHING. /api/* is a catch-all that
# forwards to the route table, and one of those routes is svc-identity — so a
# password guess and a real login were the same request shape, at whatever rate
# a socket allowed, against the component that mints the platform's tokens.
# Refusing a bad token cheaply a million times is still a million attempts.
#
# /health and /ready are never throttled: a limiter that answers a load
# balancer's probe with 429 pulls a busy-but-working edge out of rotation and
# causes the outage it was installed to prevent.
#
# Counters are IN-PROCESS. N replicas means N budgets — the fleet's real
# allowance is EDGE_RATE_LIMIT_MAX times the replica count. A shared store is a
# §13 socket, not something to assume.
# EDGE_RATE_LIMIT_ENABLED=true
# EDGE_RATE_LIMIT_MAX and EDGE_RATE_LIMIT_WINDOW_MS are set in the REQUIRED block near the top of this file.

# Who may set X-Forwarded-For. Passed straight to Fastify's `trustProxy`.
#
# READ THIS BEFORE DEPLOYING BEHIND A PROXY. Unset is the safe default and the
# useless one, and there is no default that is right for both topologies:
#
#   · Trusting the header unconditionally lets any caller forge an address and
#     walk around the throttle one fake IP at a time.
#   · NOT trusting it behind nginx or a load balancer collapses every caller
#     onto the proxy's single address, so the limit becomes ONE GLOBAL BUDGET
#     shared by all users — one attacker then throttles the whole platform, and
#     from inside it looks exactly like the control working.
#
# So state the proxy, or read what you actually got: svc-edge logs the resolved
# posture at WARN on boot when this is unset.
#
#   EDGE_TRUST_PROXY=10.0.0.0/8
# EDGE_TRUST_PROXY=

# ── svc-ws: the live depth stream (§5.2 ws.gateway) ──────────────────────────
# Reads svc-matching's UNAUTHENTICATED depth endpoint and re-broadcasts it. Note
# what is absent: this service gets no EDGE_PRINCIPAL_SECRET and no
# INTERNAL_SERVICE_SECRET, and that absence is the reason it is allowed to be a
# second public port. services/svc-ws/README.md argues it.
#
# Levels per side, and how often depth is read. One GET per SUBSCRIBED market
# per tick; markets nobody is watching are not polled at all.
WS_DEPTH_LIMIT=50
WS_POLL_INTERVAL_MS=250
# Kill-switch, mirroring the `ws.gateway` flag. Off refuses upgrades, closes
# every open socket with a reason, and returns 503 from /ready.
WS_GATEWAY_ENABLED=true

# ── apps/web: where the browser looks for the front door ─────────────────────
# NEXT_PUBLIC_ because the browser makes these calls — it is a public URL and
# must never hold a secret. Every request/response service apps/web talks to is
# behind this one origin.
NEXT_PUBLIC_EDGE_URL=http://localhost:4000

# The one exception, and it is structural rather than an oversight: svc-edge's
# proxy buffers with `response.text()`, so it cannot carry a websocket. The live
# order book is therefore a second origin the browser reaches directly. Unset
# means the book renders as unavailable with that reason on screen — never as a
# plausible ladder of numbers.
#
# NEXT_PUBLIC_* is inlined at BUILD time by Next, so changing this needs a
# rebuild of apps/web, not just a restart.
NEXT_PUBLIC_WS_URL=http://localhost:4014

# Browser origins for the vendored Java shell (CorsAllowlist).
# Local defaults already cover :8090/:3000/:5173. Production MUST set this
# (comma-separated full origins). A bare * is ignored (fail closed).
# CORS_ALLOWED_ORIGINS=https://app.example.com,https://www.example.com

# ── apps/admin: the operator console, and whether it can halt anything ───────
#
# WITHOUT THE TWO TOKENS BELOW THIS CONSOLE CANNOT HALT ANYTHING. It still
# boots, still serves the launch / drop / jurisdiction screens, and says so in a
# banner on every page naming the exact variables that are missing — but every
# switch that would stop the platform renders disabled. That is the intended
# behaviour, not a degraded one: a console that looks like it halted a market
# and did not is worse than a console that admits it cannot.
#
# NOT `NEXT_PUBLIC_`, and that is the whole design. These are read server-side
# by `apps/admin/src/lib/control-plane-client.ts` and never reach the browser;
# the board talks to this app's own `/api/kill-switch` and `/api/ledger-freeze`
# routes, which make the outbound call. A token carrying `admin:write` inlined
# into a bundle is a token in everybody's devtools.
#
# Where the edge is. `docker-compose.apps.yml` already defaults this to
# `http://svc-edge:4000` (the service name on the compose network); set it here
# only when the console runs OUTSIDE the stack — e.g.
# `pnpm --filter @intafaced/admin dev` on the host, which needs the published
# port instead:
# EDGE_URL=http://localhost:4000
#
# ── The two credentials (owner-supplied — agents must not invent these) ──────
#
# Access tokens minted for an operator principal and verified by svc-edge
# through the same `verifyAccessToken` + `requireScope` path as every other
# caller. They are NOT shared static secrets, and there is no correct value to
# put here by default — absent is the honest state.
#
#   ADMIN_OPERATOR_TOKEN  scope `admin:write`    + MFA claim
#                         -> module kill-switches (halt one market)
#   ADMIN_TREASURY_TOKEN  scope `admin:treasury` + MFA claim
#                         -> ledger posting freeze (halt ALL value movement)
#
# TWO variables, not one, because halting a market and halting the money plane
# are different authorities. A console given only the first genuinely cannot
# stop the money plane, and svc-edge enforces that split on its own side.
# See docs/OWNER-OPS-CHECKLIST-2026-07-31.md (removed) §7 for how to mint them.
# ADMIN_OPERATOR_TOKEN=
# ADMIN_TREASURY_TOKEN=
#
# Optional gate in front of the console's own BFF routes until operator SSO
# lands (§13). Set it here and have the reverse proxy inject
# `x-intafaced-admin-bff: <secret>` after it has authenticated the human. Unset
# means a network ACL is the ONLY thing in front of routes that can halt the
# platform — do not expose this app without one or the other.
# ADMIN_BFF_SHARED_SECRET=
#
# HSTS stage for the console (Strict-Transport-Security), read at runtime so one image serves every stage; compose maps these to
# HSTS_MAX_AGE_SECONDS / HSTS_INCLUDE_SUBDOMAINS. Unset means 86400 (one day) and host-only, which is also what ships today.
# max-age is an integer 0..63072000; includeSubDomains is exactly true or false. A bad value refuses to boot (config.hsts_invalid).
# More than 86400 is refused unless APP_ENV is production posture. includeSubDomains=true needs ADMIN_ORIGIN (set by the outreach
# overlay) and is refused when that host is the registrable domain itself. There is no preload setting, on purpose.
# Ramp and gates: docs/adr/2026-10-14-hsts-staged-ramp-no-preload.md. Do not raise these without that ADR's gate being met.
# ADMIN_HSTS_MAX_AGE_SECONDS=86400
# ADMIN_HSTS_INCLUDE_SUBDOMAINS=false

# ── Vendored Java platform: secrets that used to be committed ────────────────
#
# Everything in this block replaced a literal that was sitting in a git-tracked
# `application.properties`. They are listed here so an operator knows they
# exist; they are deliberately COMMENTED OUT and have NO defaults in the
# properties files, because the desired behaviour is that a service which has
# not been given one REFUSES TO START. A wallet service that boots on a stale
# credential is worse than one that does not boot: the first loses money
# quietly, the second pages someone.
#
# Uncomment and fill only what the service you are running actually needs.
# Generate anything secret with:  openssl rand -base64 32
#
# See docs/A1.4-WALLET-SECRETS-PERIMETER-2026-07-30.md for which of these are
# LIVE credentials the owner must rotate, and which are dead config.

# -- 01_wallet_rpc (custody: these services hold private keys) ----------------
# Shared secret on every /rpc/** call. Minimum 32 chars or the service refuses
# to start (RpcSecurityConfig). Without it the withdrawal endpoints are open to
# anyone who can reach the port.
# WALLET_RPC_AUTH_TOKEN=

# Deposit-keystore password for the ETH-family services (eth, erc-token,
# erc-eusdt). READ docs/RUNBOOK-ETH-KEYSTORE-REENCRYPTION.md BEFORE SETTING
# THIS ON A DEPLOYMENT THAT ALREADY HAS KEYSTORES — existing files were created
# with an empty password and stop decrypting the moment this becomes real.
# ETH_KEYSTORE_PASSWORD=
# ETH_WITHDRAW_WALLET_PASSWORD=

# EIP-155 chain id for the ETH-family withdrawal signing path (eth, erc-token,
# erc-eusdt). NOT a secret — a chain id is public — but it decides which chain a
# withdrawal is valid on, so it is the setting that makes "point it at a
# testnet" mean anything at all. There is NO DEFAULT and there must not be one:
# a default of 1 would be mainnet-by-omission. PaymentHandler refuses to
# construct without it, so the service does not start.
#
# web3j 3.3.1 takes the chain id as a `byte` and truncates v = 2*id+35|36 to
# eight bits, so the largest id it signs CORRECTLY is 109. 110 is valid for one
# recovery id and malformed for the other — right about half the time — and is
# refused rather than truncated. Reachable: mainnet 1, Kovan 42, BSC 56.
# NOT reachable without a web3j upgrade: Polygon 137, Holesky 17000,
# Arbitrum 42161, Sepolia 11155111. See
# docs/SPEC-EIP155-WALLET-RPC-WITHDRAWAL-SIGNING.md.
# ETH_CHAIN_ID=

# Address book for the wallet RPC services (MongoDB).
# WALLET_MONGODB_URI=mongodb://user:pass@host:27017/wallet

# Node RPC endpoints. These URLs embed node credentials, which is why they are
# secrets and not settings: they control a node that can sign and broadcast.
# BTC_NODE_RPC_URL=http://user:pass@host:8332/
# USDT_NODE_RPC_URL=http://user:pass@host:8332/
# ACT_NODE_RPC_URL=http://user:pass@host:8900/rpc
# USDT_WALLET_PASSWORD=

# Bytom node. The access token is <id>:<secret>.
# BYTOM_CLIENT_ACCESS_TOKEN=
# BYTOM_WALLET_PASSWORD=

# Third-party chain data. Read on the deposit watcher path, so an absent key
# means missed deposits rather than a loud failure — hence no default.
# ETHERSCAN_API_KEY=
# EOS_BLOCK_API_KEY=

# The ERC-20 contract erc-eusdt watches for deposits and calls transfer() on for
# withdrawals. NOT a secret — a contract address is public — but it is listed
# here because it is the single most consequential setting in that module: it
# names the token, and therefore the value, that the service moves.
#
# The literal that used to sit in erc-eusdt/application.properties was the LIVE
# ETHEREUM MAINNET TETHER CONTRACT, unmangled and correct. Setting this variable
# to that address points a service that holds withdrawal keys at real USDT. Do
# not, until the security review that
# docs/adr/2026-07-28-vendored-exchange-integration.md makes a precondition of
# adoption has happened — see docs/OWNER-ACTIONS-WALLET-RPC-SECRETS.md §A4.
# Nothing in this repo can build, containerise or boot that module today, and
# that is an enforced invariant, not an accident.
# EUSDT_CONTRACT_ADDRESS=

# -- 00_framework (the vendored exchange services) ---------------------------
# Guards the Spring Boot actuator under management.context-path. This one is
# not optional hygiene: with the old committed literal, /monitor/heapdump on a
# PUBLISHED port returned the entire process heap to anyone holding this repo.
# COINEX_ACTUATOR_PASSWORD=

# Redis holding the exchange HTTP sessions. Also consumed by the vendored
# exchange compose file, which currently supplies a weak default — see the
# perimeter doc; that default should go.
# COINEX_REDIS_PASSWORD=

# COINEX_MONGODB_URI=mongodb://host:27017/bitrade
# COINEX_MAIL_PASSWORD=
# SMS_GATEWAY_PASSWORD=
# ALIYUN_ACCESS_KEY_ID=
# ALIYUN_ACCESS_KEY_SECRET=
# GEETEST_PRIVATE_KEY=
# WATERPROOF_APP_SECRET_KEY=

# ── Customer site browser CSP (apps/customer, the vendor-shell container) ─────
# The customer site's Content-Security-Policy allows only its own origin. Name
# the extra origins it needs here; all optional, empty means none. Do a staging
# pass with the browser console open after changing them. A malformed value
# stops the container at start.
#
# Academy live-session media server (LiveKit): wss://host or a bare host.
# CUSTOMER_LIVEKIT_ORIGIN=
# Origin serving recorded-video presigned URLs (origin of ACADEMY_VIDEO_S3_ENDPOINT).
# CUSTOMER_STORAGE_ORIGIN=
# Further https origins for <video>/<audio>, space separated.
# CUSTOMER_MEDIA_ORIGINS=

# --- Staging / production database passwords -------------------------------
# Compose connects each service as svc_<name> with the published dev password. With APP_ENV=staging or
# prod the service refuses to boot on it. Set the real password per service (URL-safe characters only),
# e.g. SVC_LEDGER_DB_PASSWORD, SVC_IDENTITY_DB_PASSWORD, SVC_TRADE_DB_PASSWORD, SVC_NOTIFY_DB_PASSWORD,
# SVC_BANK_DB_PASSWORD, SVC_PAY_DB_PASSWORD, SVC_CONNECT_LAKE_DB_PASSWORD (one per database URL in
# docker-compose.apps.yml), and ALTER ROLE svc_<name> PASSWORD '...' in the database to match: the init
# SQL creates the roles with the dev password.
# svc-identity also needs WEBAUTHN_RP_ID and an https WEBAUTHN_ORIGIN (or WEBAUTHN_ENABLED=off).
# REQUIRED with APP_ENV=staging or prod: a service holding INTERNAL_SERVICE_SECRET refuses to boot
# (config.s2s_body_bind_not_required) unless this is exactly `require`. The compose default accept-both is for local runs only.
# INTERNAL_SERVICE_BODY_BIND=require

# Guest support requests (J-support-public-03). Secrets: deploy environment only, never here.
# SUPPORT_GUEST_ADDRESS_KEY=        64 hex; seals a guest's address
# NOTIFY_SUPPORT_SERVICE_SECRET=    32+ chars; svc-support's secret for svc-notify's guest verification door
SUPPORT_PUBLIC_ORIGIN=
