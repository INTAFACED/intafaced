# LOCAL TEST values for the tester profile only; never a live value.
#
# Layered after .env.example by a fresh `docker compose --env-file .env.example --env-file .env.tester --profile tester up`
# (J-home-ia-11 #1), so the tester profile can start from the repo alone. .env.example keeps these blank on purpose: a real
# deployment sets each one, and with it blank compose refuses to start (`${VAR:?}`). Nothing here is an owner decision.

# Edge's per-address request budget: the LOCAL TEST values `pnpm local:stack` already runs on
# (tooling/scripts/local-stack-services/edge.mjs).
EDGE_RATE_LIMIT_MAX=6000
EDGE_RATE_LIMIT_WINDOW_MS=60000

# The AI gateway is in the `ai` profile, which the tester profile never starts. Compose still reads every service's
# required values, so these two only let it parse: not a key and no config.
LITELLM_MASTER_KEY=placeholder-not-a-key-tester-profile
LITELLM_CONFIG_PATH=/dev/null
