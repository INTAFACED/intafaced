  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "node --input-type=module -e \"import {existsSync} from 'node:fs'; process.exit(['auth','config'].some((n)=>!existsSync('../../packages/'+n+'/dist/index.d.ts'))?1:0)\" || pnpm --filter @intafaced/contracts^... run --if-present build && tsc -p tsconfig.json --noEmit && node ../../tooling/ci/test-typecheck.mjs",
    "test": "tsc -p tsconfig.json && vitest run",
    "test:watch": "vitest",
    "clean": "rimraf dist .turbo"
  },
