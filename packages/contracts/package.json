{
  "name": "@intafaced/contracts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./analytics-metric-honesty": null,
    "./bank-transfer-id": null,
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "node --input-type=module -e \"import {existsSync} from 'node:fs'; process.exit(['auth','config'].some((n)=>!existsSync('../../packages/'+n+'/dist/index.d.ts'))?1:0)\" || pnpm --filter @intafaced/contracts^... run --if-present build && tsc -p tsconfig.json --noEmit && node ../../tooling/ci/test-typecheck.mjs",
    "test": "tsc -p tsconfig.json && vitest run",
    "test:watch": "vitest",
    "clean": "rimraf dist .turbo"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "8.5.0",
    "@intafaced/auth": "workspace:*",
    "@intafaced/config": "workspace:*",
    "@trpc/server": "^11.25.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@typescript/typescript6": "6.0.2",
    "rimraf": "^6.1.4",
    "typescript": "^7.0.2",
    "vitest": "^4.1.12"
  }
}
