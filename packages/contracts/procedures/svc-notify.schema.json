    "notify.deliveries": {
      "service": "svc-notify",
      "module": "notify",
      "transport": "trpc",
      "kind": "query",
      "path": "notify.deliveries",
      "access": {
        "caller": "scope",
        "scope": "notify:read",
        "module": "notify"
      },
      "refusals": {},
      "input": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "notificationId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$"
          }
        },
        "required": ["notificationId"]
      },
      "output": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "channel": {
              "type": "string",
              "enum": ["inapp", "email", "push", "sms"]
            },
            "status": {
              "type": "string",
              "enum": ["pending", "accepted", "refused", "failed", "abandoned"]
            },
            "attempts": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "attemptedAt": {
              "type": ["string", "null"]
            },
            "acceptedAt": {
              "type": ["string", "null"]
            },
            "refusalCode": {
              "type": ["string", "null"]
            }
          },
          "required": ["channel", "status", "attempts", "attemptedAt", "acceptedAt", "refusalCode"],
          "additionalProperties": false
        }
      },
      "accept": {
        "atMostEight": "at most eight delivery rows"
      },
      "samples": [
        {
          "verdict": "accept",
          "input": {
            "notificationId": "33333333-3333-4333-8333-333333333333"
          }
        },
        {
          "verdict": "refuse",
          "input": {
            "notificationId": "not-an-id"
          }
        }
      ]
    },
