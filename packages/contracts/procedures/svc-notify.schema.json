    "notify.registerTarget": {
      "service": "svc-notify",
      "module": "notify",
      "transport": "trpc",
      "kind": "mutation",
      "path": "notify.registerTarget",
      "access": {
        "caller": "scope",
        "scope": "notify:write",
        "module": "notify"
      },
      "refusals": {
        "notify.verify_ttl_unset": "PRECONDITION_FAILED",
        "notify.verify_code_pepper_unset": "PRECONDITION_FAILED"
      },
      "input": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "channel": {
                "type": "string",
                "const": "email"
              },
              "address": {
                "type": "string",
                "maxLength": 320,
                "format": "email",
                "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
              },
              "locale": {
                "type": "string",
                "maxLength": 16
              }
            },
            "required": ["channel", "address"]
          },
          {
            "type": "object",
            "properties": {
              "channel": {
                "type": "string",
                "const": "sms"
              },
              "address": {
                "type": "string",
                "pattern": "^\\+[1-9]\\d{6,14}$"
              },
              "locale": {
                "type": "string",
                "maxLength": 16
              }
            },
            "required": ["channel", "address"]
          },
          {
            "type": "object",
            "properties": {
              "channel": {
                "type": "string",
                "const": "push"
              },
              "address": {
                "type": "string",
                "minLength": 8,
                "maxLength": 4096
              },
              "locale": {
                "type": "string",
                "maxLength": 16
              }
            },
            "required": ["channel", "address"]
          }
        ]
      },
      "output": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": ["sent", "refused", "failed"]
          },
          "channel": {
            "type": "string",
            "enum": ["email", "push", "sms"]
          },
          "code": {
            "type": ["string", "null"]
          },
          "expiresAt": {
            "type": "string"
          }
        },
        "required": ["status", "channel", "code", "expiresAt"],
        "additionalProperties": false
      },
      "accept": {
        "codeOnlyWhenRefused": "a refused registration names its refusal code; a sent or failed one names none"
      },
      "samples": [
        {
          "verdict": "accept",
          "input": {
            "channel": "sms",
            "address": "+447700900000"
          }
        },
        {
          "verdict": "refuse",
          "input": {
            "channel": "sms",
            "address": "07700900000"
          }
        }
      ]
    },
