{
  "name": "@intafaced/events",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && node ../../tooling/ci/test-typecheck.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rimraf dist .turbo",
    "cx8-streams": "node ./scripts/cx8-ensure-streams.mjs"
  },
  "dependencies": {
    "@intafaced/config": "workspace:*",
    "@intafaced/safe-regex": "workspace:^",
    "nats": "^2.28.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@intafaced/db": "workspace:*",
    "@types/node": "^22.20.5",
    "rimraf": "^6.0.1",
    "typescript": "^5.7.2",
    "vitest": "^3.0.5"
  }
}
