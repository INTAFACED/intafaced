{
  "name": "@intafaced/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./tokens": {
      "types": "./dist/tokens.d.ts",
      "default": "./dist/tokens.js"
    },
    "./a11y": {
      "types": "./dist/a11y/index.d.ts",
      "default": "./dist/a11y/index.js"
    },
    "./a11y/a11y.css": "./src/a11y/a11y.css",
    "./tokens.css": "./src/tokens.css",
    "./theme/tokens.css": "./src/theme/tokens.css",
    "./theme/customer-legacy.css": "./src/theme/customer-legacy.css",
    "./theme/theme.css": "./src/theme/theme.css",
    "./theme/base.css": "./src/theme/base.css",
    "./lit": {
      "types": "./dist/lit/index.d.ts",
      "default": "./dist/lit/index.js"
    },
    "./lit/lit.css": "./src/lit/lit.css",
    "./lit/components.css": "./src/lit/components/components.css",
    "./lit/fx": {
      "types": "./dist/lit/fx/index.d.ts",
      "default": "./dist/lit/fx/index.js"
    },
    "./lit/fx/posters/*": "./src/lit/fx/posters/*",
    "./lit/fonts.css": "./src/lit/fonts.css",
    "./lit/templates": {
      "types": "./dist/lit/templates/index.d.ts",
      "default": "./dist/lit/templates/index.js"
    },
    "./lit/templates.css": "./src/lit/templates/templates.css"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && node ../../tooling/ci/test-typecheck.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rimraf dist .turbo",
    "gallery": "vite --config gallery/vite.config.ts --host 127.0.0.1 --port 3290",
    "gallery:build": "vite build --config gallery/vite.config.ts",
    "gallery:shots": "node gallery/shots.mjs",
    "fx:lab": "vite --config fx-lab/vite.config.ts",
    "fx:posters": "node fx-lab/posters.mjs"
  },
  "peerDependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.2.4",
    "@types/three": "0.186.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "rimraf": "^6.0.1",
    "tailwindcss": "4.3.3",
    "typescript": "^7.0.2",
    "vite": "8.3.4",
    "vitest": "^3.0.5"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@number-flow/react": "0.6.2",
    "@tanstack/react-virtual": "3.14.21",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.58.0",
    "tailwind-merge": "3.7.0",
    "three": "0.186.1"
  }
}
