{
  "name": "@intafaced/sbe-codec",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "description": "Real Logic SBE 1.39.0 codec adapter. Our schema. Decimal strings. Not a book. Not NATS.",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && node ../../tooling/ci/test-typecheck.mjs",
    "test": "node scripts/run-mvn.mjs test && vitest run && node scripts/linked-roundtrip.mjs",
    "test:watch": "vitest",
    "generate": "node scripts/run-mvn.mjs generate-sources",
    "codec": "node scripts/run-codec.mjs",
    "clean": "rimraf dist .turbo target"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "rimraf": "^6.0.1",
    "typescript": "^5.7.2",
    "vitest": "^3.0.5"
  }
}
