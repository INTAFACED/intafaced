{
  "$comment": "Written by `procedures:write`; held by its drift test. Do not edit by hand.",
  "procedures": {
    "ledger.historyPage": {
      "service": "svc-ledger",
      "transport": "http",
      "method": "POST",
      "path": "/trpc/historyPage",
      "access": {
        "caller": "service",
        "callers": [
          "svc-agents",
          "svc-bank",
          "svc-identity",
          "svc-market",
          "svc-mining-pool",
          "svc-p2p",
          "svc-pay",
          "svc-token",
          "svc-trade",
          "svc-matching",
          "svc-tax"
        ]
      },
      "refusals": {
        "ledger.history_cursor_invalid": "BAD_REQUEST",
        "ledger.unauthenticated": "UNAUTHORIZED",
        "s2s.caller_forbidden": "FORBIDDEN"
      },
      "input": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "ownerType": {
            "type": "string",
            "enum": ["user", "subaccount", "module", "house", "treasury"]
          },
          "ownerId": {
            "type": "string",
            "minLength": 1
          },
          "assetId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 16
          },
          "kind": {
            "type": "string",
            "enum": ["available", "hold", "escrow", "stake", "collateral"]
          },
          "purpose": {
            "type": "string",
            "maxLength": 128
          },
          "limit": {
            "default": 50,
            "type": "integer",
            "minimum": 1,
            "maximum": 200
          },
          "cursor": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        },
        "required": ["ownerType", "ownerId", "kind"],
        "additionalProperties": false
      },
      "output": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "entries": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "txId": {
                  "type": "string"
                },
                "module": {
                  "type": "string"
                },
                "reason": {
                  "type": "string"
                },
                "direction": {
                  "type": "string",
                  "enum": ["debit", "credit"]
                },
                "amount": {
                  "type": "string"
                },
                "postedAt": {
                  "type": "string"
                },
                "assetId": {
                  "type": "string"
                },
                "entryId": {
                  "type": "string"
                },
                "rail": {
                  "anyOf": [
                    {
                      "type": "string",
                      "enum": ["crypto-native", "card-sandbox", "bank-crypto-ledger", "local-test"]
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "product": {
                  "anyOf": [
                    {
                      "type": "string",
                      "enum": ["convert"]
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "orderId": {
                  "anyOf": [
                    {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "fee": {
                  "type": ["string", "null"]
                },
                "withdrawalId": {
                  "type": ["string", "null"]
                }
              },
              "required": [
                "txId",
                "module",
                "reason",
                "direction",
                "amount",
                "postedAt",
                "assetId",
                "entryId",
                "rail",
                "product",
                "orderId",
                "fee",
                "withdrawalId"
              ],
              "additionalProperties": false
            }
          },
          "nextCursor": {
            "type": ["string", "null"]
          }
        },
        "required": ["entries", "nextCursor"],
        "additionalProperties": false
      },
      "checks": {
        "ledger.owner_id_space": {
          "at": "input",
          "says": "ownerId is drawn from the space its ownerType declares (a lowercase UUID for a person's account, a slug for a platform one)"
        }
      },
      "samples": [
        {
          "verdict": "accept",
          "input": {
            "ownerType": "user",
            "ownerId": "11111111-1111-4111-8111-111111111111",
            "kind": "available"
          }
        },
        {
          "verdict": "accept",
          "input": {
            "ownerType": "user",
            "ownerId": "11111111-1111-4111-8111-111111111111",
            "kind": "available",
            "assetId": "USDT",
            "limit": 200,
            "cursor": "c"
          }
        },
        {
          "verdict": "refuse",
          "by": "ledger.owner_id_space",
          "input": {
            "ownerType": "user",
            "ownerId": "fees:trade",
            "kind": "available"
          }
        },
        {
          "verdict": "refuse",
          "input": {
            "ownerType": "user",
            "ownerId": "11111111-1111-4111-8111-111111111111",
            "kind": "available",
            "limit": 201
          }
        },
        {
          "verdict": "refuse",
          "input": {
            "ownerType": "user",
            "ownerId": "11111111-1111-4111-8111-111111111111",
            "kind": "available",
            "before": "x"
          }
        }
      ]
    }
  }
}
