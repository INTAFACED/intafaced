              "recipe": {
                "type": "string",
                "const": "academyPurchase"
              },
              "input": {
                "type": "object",
                "properties": {
                  "course": {
                    "type": "string",
                    "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
                  },
                  "userId": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                  },
                  "n": {
                    "type": "string",
                    "pattern": "^[1-9][0-9]{0,18}$"
                  },
                  "assetId": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 32,
                    "pattern": "^[^\\s]+$"
                  },
                  "amount": {
                    "type": "string",
                    "maxLength": 64,
                    "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]{1,18})?$"
                  },
                  "paymentId": {
                    "type": "string",
                    "pattern": "^0x[0-9a-f]{64}$"
                  },
                  "to": {
                    "oneOf": [
                      {
                        "type": "object",
                        "properties": {
                          "kind": {
                            "type": "string",
                            "const": "treasury-wallet"
                          },
                          "walletId": {
                            "type": "string",
                            "maxLength": 128,
                            "pattern": "^[a-z0-9][a-z0-9:_-]*$"
                          }
                        },
                        "required": ["kind", "walletId"],
                        "additionalProperties": false
                      },
                      {
                        "type": "object",
                        "properties": {
                          "kind": {
                            "type": "string",
                            "const": "venue-builder-account"
                          },
                          "venueId": {
                            "type": "string",
                            "maxLength": 128,
                            "pattern": "^[a-z0-9][a-z0-9:_-]*$"
                          }
                        },
                        "required": ["kind", "venueId"],
                        "additionalProperties": false
                      },
                      {
                        "type": "object",
                        "properties": {
                          "kind": {
                            "type": "string",
                            "const": "partner-reserve"
                          },
                          "partnerId": {
                            "type": "string",
                            "maxLength": 128,
                            "pattern": "^[a-z0-9][a-z0-9:_-]*$"
                          }
                        },
                        "required": ["kind", "partnerId"],
                        "additionalProperties": false
                      }
                    ]
                  }
                },
                "required": ["course", "userId", "n", "assetId", "amount", "paymentId", "to"],
                "additionalProperties": false
              }
            },
            "required": ["recipe", "input"],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "recipe": {
                "type": "string",
                "const": "academyPurchaseRefund"
              },
              "input": {
                "type": "object",
                "properties": {
