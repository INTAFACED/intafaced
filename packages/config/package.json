{
  "name": "@intafaced/config",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./env": {
      "types": "./dist/env.d.ts",
      "default": "./dist/env.js"
    },
    "./flags": {
      "types": "./dist/flags.d.ts",
      "default": "./dist/flags.js"
    },
    "./modules": {
      "types": "./dist/modules.d.ts",
      "default": "./dist/modules.js"
    },
    "./jurisdiction": {
      "types": "./dist/jurisdiction.d.ts",
      "default": "./dist/jurisdiction.js"
    },
    "./screening": {
      "types": "./dist/screening.d.ts",
      "default": "./dist/screening.js"
    },
    "./fiat": {
      "types": "./dist/fiat.d.ts",
      "default": "./dist/fiat.js"
    },
    "./network-signal": {
      "types": "./dist/network-signal.d.ts",
      "default": "./dist/network-signal.js"
    },
    "./compliance-queue": {
      "types": "./dist/compliance-queue.d.ts",
      "default": "./dist/compliance-queue.js"
    },
    "./freeze-authority": {
      "types": "./dist/freeze-authority.d.ts",
      "default": "./dist/freeze-authority.js"
    },
    "./money-kill-surface": {
      "types": "./dist/money-kill-surface.d.ts",
      "default": "./dist/money-kill-surface.js"
    },
    "./marketing-language": {
      "types": "./dist/marketing-language.d.ts",
      "default": "./dist/marketing-language.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && node ../../tooling/ci/test-typecheck.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rimraf dist .turbo"
  },
  "dependencies": {
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "rimraf": "^6.0.1",
    "typescript": "^5.7.2",
    "vitest": "^3.0.5"
  }
}
