#!/bin/sh
#
# Refuse direct push to main, require format:check, then run the pre-push checks (tooling/scripts/pre-push.mjs: the
# Doctrine gates, the affected typecheck and the changed packages' unit tests) before any push.
# INTAFACED_PRE_PUSH_SKIP="<why>" skips the pre-push checks by name and logs it; --no-verify skips this whole hook and
# logs nothing, so do not use it. Real enforcement is CI and the ruleset on main.
#
# P1: format:check covers tooling/scripts/*.mjs (what red-trunked main via #471).
# Worktrees often lack node_modules — resolve prettier from git-common-dir parent.

TOP=$(git rev-parse --show-toplevel)

# git's pushed refs, read once: the main check below and the pre-push checks both need them.
REFS=$(cat)

# First, so a push to main is refused before minutes of checks.
protected="main"
remote_ref_prefix="refs/heads/"

printf '%s\n' "$REFS" | while read -r local_ref _local_sha remote_ref _remote_sha; do
  [ -n "$remote_ref" ] || continue
  branch="${remote_ref#$remote_ref_prefix}"

  if [ "$branch" = "$protected" ]; then
    cat >&2 <<'MESSAGE'

  ✖ Direct push to main refused.

    main is always deployable and changes reach it through a reviewed PR
    (CONTRIBUTING.md §1).

    Instead:
      pnpm wt feat/your-change
      git push -u origin feat/your-change
      gh pr create --fill

    If you genuinely need to push main:
      git push --no-verify

MESSAGE
    exit 1
  fi
done || exit 1

# Resolve the MAIN checkout from --git-common-dir, whose parent is the main
# working tree. Two spellings have to be handled, and getting this wrong is why
# every push from a worktree used to print
#   cd: .../plug-x-inta-worktrees/<wt>/C:/Users/User/PLUG X INTA: No such file
#
#   main checkout   → ".git"                       (relative to $TOP)
#   linked worktree → "C:/Users/User/repo/.git"    (absolute, Git Bash on Windows)
#
# The old code tested only `/*` for "already absolute". A Windows absolute path
# starts with a drive letter, not a slash, so it fell through to the relative
# branch and concatenated an absolute path onto $TOP. Non-fatal — REPO_ROOT just
# came out empty and prettier was found via $TOP — but it cried wolf on every
# push. `git rev-parse --show-toplevel` always returns forward slashes; other
# rev-parse outputs do not normalise, hence matching both forms below.
# (`--path-format=absolute` would do this in one call but needs git >= 2.31.)
COMMON_GIT=$(git rev-parse --git-common-dir)
case "$COMMON_GIT" in
  /*) ;;                                       # POSIX absolute
  [A-Za-z]:*) ;;                               # Windows absolute, e.g. C:/repo/.git
  *) COMMON_GIT="$TOP/$COMMON_GIT" ;;          # relative — hooks run from $TOP
esac
REPO_ROOT=$(CDPATH= cd -- "$COMMON_GIT/.." 2>/dev/null && pwd) || REPO_ROOT=""
[ -n "$REPO_ROOT" ] || REPO_ROOT="$TOP"

PRETTIER=""
if [ -x "$TOP/node_modules/.bin/prettier" ]; then
  PRETTIER="$TOP/node_modules/.bin/prettier"
elif [ -x "$REPO_ROOT/node_modules/.bin/prettier" ]; then
  PRETTIER="$REPO_ROOT/node_modules/.bin/prettier"
fi

if [ -n "$PRETTIER" ]; then
  # Format only files this push introduces vs origin/main. Full-tree prettier
  # on ~4k files hung agent pushes for minutes (L15 wave 4) and was routinely
  # --no-verify'd — which is how #471 red-trunked. Scoped check is the same
  # gate with a usable runtime. Only files in this push are checked.
  RANGE_BASE=$(git merge-base HEAD origin/main 2>/dev/null || git rev-parse origin/main 2>/dev/null || true)
  FILES=""
  if [ -n "$RANGE_BASE" ]; then
    FILES=$(git diff --name-only --diff-filter=ACMR "$RANGE_BASE"...HEAD 2>/dev/null | grep -E '\.(ts|tsx|mjs|js|md|json|yml|yaml)$' || true)
  fi
  WT_FILES=$(git diff --name-only --diff-filter=ACMR HEAD 2>/dev/null | grep -E '\.(ts|tsx|mjs|js|md|json|yml|yaml)$' || true)
  STAGED=$(git diff --cached --name-only --diff-filter=ACMR 2>/dev/null | grep -E '\.(ts|tsx|mjs|js|md|json|yml|yaml)$' || true)
  ALL_FILES=$(printf '%s\n%s\n%s\n' "$FILES" "$WT_FILES" "$STAGED" | sort -u | grep -v '^$' || true)
  if [ -z "$ALL_FILES" ]; then
    echo "format:check — no matching files in push range; skip"
  else
    echo "Checking formatting on push range..."
    if ! (CDPATH= cd -- "$TOP" && echo "$ALL_FILES" | tr '\n' '\0' | xargs -0 "$PRETTIER" --check); then
      cat >&2 <<'MSG'

  ✖ format:check failed — refuse push.

    Fix: prettier --write on the named files (or pnpm format from a full install).
    This is the gate that failed when #471 merged before CI (swarm.mjs).
    Only files in this push are checked (not the whole tree).

MSG
      exit 1
    fi
  fi
elif command -v pnpm >/dev/null 2>&1; then
  if ! (CDPATH= cd -- "$TOP" && pnpm format:check); then
    echo "✖ pnpm format:check failed — refuse push." >&2
    exit 1
  fi
else
  echo "warn: no prettier binary found; skipping format:check on push" >&2
fi

# Local agent-rule drift check. Not a GitHub workflow. Stdin stays with the loop below.
if ! command -v node >/dev/null 2>&1; then
  echo "truth-check: node is missing — refuse push." >&2
  exit 1
fi
if ! (CDPATH= cd -- "$TOP" && node tooling/scripts/truth-check.mjs) </dev/null; then
  cat >&2 <<'MSG'

  ✖ truth-check failed — push refused.

    Fix the named lines (AGENTS.md is the truth); archive files arrive by
    git mv; list new docs in docs/README.md.

MSG
  exit 1
fi

# The pre-push checks: what CI's first run would refuse (plan 2026-11-06, Now 3). They print what they run and why
# they refuse; the escape is named and logged there.
if ! (CDPATH= cd -- "$TOP" && printf '%s\n' "$REFS" | node tooling/scripts/pre-push.mjs); then
  exit 1
fi

exit 0
