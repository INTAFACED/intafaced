#!/bin/sh
#
# Refuse direct push to main + require format:check and truth-check before any push. CI's checks run on GitHub.
# Safety net only — --no-verify bypasses; real enforcement is branch protection (needs Pro).
#
# P1: format:check covers tooling/scripts/*.mjs (what red-trunked main via #471).
# Worktrees often lack node_modules — resolve prettier from git-common-dir parent.

TOP=$(git rev-parse --show-toplevel)

# Resolve the MAIN checkout from --git-common-dir, whose parent is the main
# working tree. Two spellings have to be handled, and getting this wrong is why
# every push from a worktree used to print
#   cd: .../plug-x-inta-worktrees/<wt>/C:/Users/User/PLUG X INTA: No such file
#
#   main checkout   → ".git"                       (relative to $TOP)
#   linked worktree → "C:/Users/User/repo/.git"    (absolute, Git Bash on Windows)
#
# The old code tested only `/*` for "already absolute". A Windows absolute path
# starts with a drive letter, not a slash, so it fell through to the relative
# branch and concatenated an absolute path onto $TOP. Non-fatal — REPO_ROOT just
# came out empty and prettier was found via $TOP — but it cried wolf on every
# push. `git rev-parse --show-toplevel` always returns forward slashes; other
# rev-parse outputs do not normalise, hence matching both forms below.
# (`--path-format=absolute` would do this in one call but needs git >= 2.31.)
COMMON_GIT=$(git rev-parse --git-common-dir)
case "$COMMON_GIT" in
  /*) ;;                                       # POSIX absolute
  [A-Za-z]:*) ;;                               # Windows absolute, e.g. C:/repo/.git
  *) COMMON_GIT="$TOP/$COMMON_GIT" ;;          # relative — hooks run from $TOP
esac
REPO_ROOT=$(CDPATH= cd -- "$COMMON_GIT/.." 2>/dev/null && pwd) || REPO_ROOT=""
[ -n "$REPO_ROOT" ] || REPO_ROOT="$TOP"

PRETTIER=""
if [ -x "$TOP/node_modules/.bin/prettier" ]; then
  PRETTIER="$TOP/node_modules/.bin/prettier"
elif [ -x "$REPO_ROOT/node_modules/.bin/prettier" ]; then
  PRETTIER="$REPO_ROOT/node_modules/.bin/prettier"
fi

if [ -n "$PRETTIER" ]; then
  # Format only files this push introduces vs origin/main. Full-tree prettier
  # on ~4k files hung agent pushes for minutes (L15 wave 4) and was routinely
  # --no-verify'd — which is how #471 red-trunked. Scoped check is the same
  # gate with a usable runtime. Only files in this push are checked.
  RANGE_BASE=$(git merge-base HEAD origin/main 2>/dev/null || git rev-parse origin/main 2>/dev/null || true)
  FILES=""
  if [ -n "$RANGE_BASE" ]; then
    FILES=$(git diff --name-only --diff-filter=ACMR "$RANGE_BASE"...HEAD 2>/dev/null | grep -E '\.(ts|tsx|mjs|js|md|json|yml|yaml)$' || true)
  fi
  WT_FILES=$(git diff --name-only --diff-filter=ACMR HEAD 2>/dev/null | grep -E '\.(ts|tsx|mjs|js|md|json|yml|yaml)$' || true)
  STAGED=$(git diff --cached --name-only --diff-filter=ACMR 2>/dev/null | grep -E '\.(ts|tsx|mjs|js|md|json|yml|yaml)$' || true)
  ALL_FILES=$(printf '%s\n%s\n%s\n' "$FILES" "$WT_FILES" "$STAGED" | sort -u | grep -v '^$' || true)
  if [ -z "$ALL_FILES" ]; then
    echo "format:check — no matching files in push range; skip"
  else
    echo "Checking formatting on push range..."
    if ! (CDPATH= cd -- "$TOP" && echo "$ALL_FILES" | tr '\n' '\0' | xargs -0 "$PRETTIER" --check); then
      cat >&2 <<'MSG'

  ✖ format:check failed — refuse push.

    Fix: prettier --write on the named files (or pnpm format from a full install).
    This is the gate that failed when #471 merged before CI (swarm.mjs).
    Only files in this push are checked (not the whole tree).

MSG
      exit 1
    fi
  fi
else
  # No prettier here or in the main checkout (a fresh worktree before its install): skip, never refuse. CI's format
  # check still runs on the push. Was a fallback to `pnpm format:check`, which fails without node_modules and so refused
  # the first push in 12 of 20 sampled builder threads (project-state garden stake-02; the lead on #2065, 13 Nov).
  echo "format:check — no prettier in this worktree; skipped (pnpm install --frozen-lockfile --prefer-offline); CI checks it" >&2
fi

# Local agent-rule drift check. Not a GitHub workflow. Stdin stays with the loop below.
if ! command -v node >/dev/null 2>&1; then
  echo "truth-check: node is missing — refuse push." >&2
  exit 1
fi
if ! (CDPATH= cd -- "$TOP" && node tooling/scripts/truth-check.mjs) </dev/null; then
  cat >&2 <<'MSG'

  ✖ truth-check failed — push refused.

    Fix the named lines (AGENTS.md is the truth); archive files arrive by
    git mv; list new docs in docs/README.md.

MSG
  exit 1
fi

# The tooling tests that read every journey file, when this push changes one. They take under a second together, and a
# journey file that breaks one is otherwise first seen as a red Doctrine gates job minutes after the push (J-merchant-01
# and J-algo-dev-03 on 14 Nov, each a push spent on journey-navigation.test.mjs). A test joins by its marker line;
# the slow tooling tests stay in CI.
JOURNEY_SCAN_MARK='^// Before a push: runs from .githooks/pre-push when the push changes a journey file'
SCAN_BASE=$(git merge-base HEAD origin/main 2>/dev/null || true)
if [ -n "$SCAN_BASE" ] && git diff --name-only "$SCAN_BASE" HEAD 2>/dev/null | grep -qE '^apps/[^/]+/tests/real-app/'; then
  SCANS=$(CDPATH= cd -- "$TOP" && grep -rlE --include='*.test.mjs' --exclude-dir=node_modules "$JOURNEY_SCAN_MARK" tooling 2>/dev/null | sort)
  if [ -n "$SCANS" ]; then
    echo "journey-file scans: $(echo "$SCANS" | wc -l | tr -d ' ') tooling test file(s)"
    # A push made inside a node test (pre-push-hook.test.mjs) would hand node's test context on, and `node --test`
    # would then skip every file and pass; the scan always runs as its own test run.
    # shellcheck disable=SC2086 # one path per word; no tooling test path holds a space
    if ! (CDPATH= cd -- "$TOP" && env -u NODE_TEST_CONTEXT node --test --test-concurrency=1 $SCANS) </dev/null; then
      cat >&2 <<'MSG'

  ✖ a tooling test that reads every journey file failed — push refused.

    The failed test and its message are above. CI's Doctrine gates job runs the same test and would fail the same way.

MSG
      exit 1
    fi
  fi
  # The merge seal's title rule for journey files (journey-seal.mjs titleBeforePush): the title it needs, before the push.
  if [ -f "$TOP/tooling/ci/journey-seal.mjs" ] && ! (CDPATH= cd -- "$TOP" && node tooling/ci/journey-seal.mjs --before-push) </dev/null; then exit 1; fi
fi

# CI's lint ratchet (a Doctrine gate), the same command on the files this push touches against origin/main, with main's
# rules: under 2 seconds. A push that raised a rule was otherwise first seen as a red Doctrine gates job minutes after it
# (J-campaigns-03 and J-agents-01 on 14 Nov, each a push spent on garden/no-promise-copy in a copy file). It needs this
# worktree's oxlint; without it (before the install) it is skipped, never refused, and CI still runs it.
if [ -x "$TOP/node_modules/.bin/oxlint" ] && [ -f "$TOP/tooling/ci/lint-ratchet.mjs" ]; then
  # --rules-ref: this hook runs on the Mac against origin/main; without it, under GITHUB_ACTIONS (its own tests in CI)
  # the gate fetches the repository's main, which shares no history with a test's planted repository.
  if ! (CDPATH= cd -- "$TOP" && node tooling/ci/lint-ratchet.mjs --rules-ref origin/main) </dev/null; then
    cat >&2 <<'MSG'

  ✖ lint-ratchet failed — push refused.

    The rule, the file and the fix are named above. CI's Doctrine gates job runs the same check and would fail the same way.

MSG
    exit 1
  fi
else
  echo "lint-ratchet — no oxlint in this worktree; skipped (pnpm install --frozen-lockfile --prefer-offline); CI checks it" >&2
fi

# CI's cross-package read scan (1.6 s on CI) when a test or what it checks changed: else a red after the push (4, 13-14 Nov).
if git diff --name-only "${SCAN_BASE:-HEAD}" HEAD | grep -qE '\.test\.|turbo\.json$|package\.json$|test-read-edges\.json$' &&
  ! (CDPATH= cd -- "$TOP" && node tooling/ci/cross-package-reads.mjs) </dev/null; then exit 1; fi

protected="main"
remote_ref_prefix="refs/heads/"

# The refs this push sends, kept for the checks below the loop (git gives them once, on stdin).
PUSHED=$(mktemp)
cat > "$PUSHED"

while read -r local_ref _local_sha remote_ref _remote_sha; do
  branch="${remote_ref#$remote_ref_prefix}"

  if [ "$branch" = "$protected" ]; then
    cat >&2 <<'MESSAGE'

  ✖ Direct push to main refused.

    main is always deployable and changes reach it through a reviewed PR
    (CONTRIBUTING.md §1).

    Instead:
      git switch -c feat/your-change
      git push -u origin feat/your-change
      gh pr create --fill

    If you genuinely need to push main:
      git push --no-verify

MESSAGE
    rm -f "$PUSHED"
    exit 1
  fi
done < "$PUSHED"

# CI's checks (gates, build, typecheck, tests) run on GitHub, not here: on the branch before the pull request
# (`gh workflow run ci.yml --ref <branch>`, which prints the run's URL), then on the pull request. On the Mac they took
# 13 to 91 minutes a push under three builders and 8 of 17 tries ended for reasons outside the change; GitHub runs them
# in 9 to 20. This hook keeps only what takes seconds: formatting of the pushed files, the agent-rule check, the
# tooling tests that read journey files (when one is pushed), the lint ratchet on the pushed files and the refusal of
# main. `node tooling/scripts/ci-checks.mjs` still runs CI's checks here by hand, to diagnose a red.
if [ -z "${CI:-}" ] && grep -qv ' 0000000000000000000000000000000000000000 ' "$PUSHED"; then
  echo "CI's checks run on GitHub: gh workflow run ci.yml -R INTAFACED/intafaced --ref <branch>, before the pull request" >&2
fi
rm -f "$PUSHED"

exit 0
